Subject: adapt division cost by second operand

Change-Id: I319e41bdd109bbe475f947b3dd8fc7df9c89b106
---
 gcc/config/riscv/riscv.cc | 25 ++++++++++++++++++++++---
 gcc/expmed.cc             | 11 +++++++++++
 gcc/expmed.h              | 27 +++++++++++++++++++++++++++
 3 files changed, 60 insertions(+), 3 deletions(-)

diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 3460a171c96..e93787a1003 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -3222,6 +3222,22 @@ riscv_extend_cost (rtx op, bool unsigned_p)
   return COSTS_N_INSNS (2);
 }
 
+static int
+cloudbear_div_cost (machine_mode mode, HOST_WIDE_INT divisor) {
+  int target_wide;
+  divisor = (divisor < 0) ? -divisor : divisor;
+  if (mode == DImode) {
+    target_wide = 64;
+  } else if (mode == SImode) {
+    target_wide = 32;
+  } else if (mode == HImode) {
+    target_wide = 16;
+  } else {
+    target_wide = sizeof(HOST_WIDE_INT);
+  }
+  return MAX ((sizeof(HOST_WIDE_INT) - target_wide + clz_hwi (divisor)) / 2, 3);
+}
+
 /* Implement TARGET_RTX_COSTS.  */
 
 #define SINGLE_SHIFT_COST 1
@@ -3669,9 +3685,12 @@ riscv_rtx_costs (rtx x, machine_mode mode, int outer_code, int opno ATTRIBUTE_UN
       if (!TARGET_DIV)
 	/* Estimate the cost of a library call.  */
 	*total = COSTS_N_INSNS (speed ? 32 : 6);
-      else if (speed)
-	*total = tune_param->int_div[mode == DImode];
-      else
+      else if (speed) {
+	if (CONST_INT_P (XEXP (x, 1))) {
+	  *total = COSTS_N_INSNS (cloudbear_div_cost (mode, INTVAL (XEXP (x, 1))));
+	} else
+	  *total = tune_param->int_div[mode == DImode];
+      } else
 	*total = COSTS_N_INSNS (1);
       return false;
 
diff --git a/gcc/expmed.cc b/gcc/expmed.cc
index 4ec035e4843..3e75c93deaa 100644
--- a/gcc/expmed.cc
+++ b/gcc/expmed.cc
@@ -112,6 +112,7 @@ struct init_expmed_rtl
   rtx mult;
   rtx sdiv;
   rtx udiv;
+  rtx div_const;
   rtx sdiv_32;
   rtx smod_32;
   rtx wide_mult;
@@ -175,6 +176,7 @@ init_expmed_one_mode (struct init_expmed_rtl *all,
   PUT_MODE (all->mult, mode);
   PUT_MODE (all->sdiv, mode);
   PUT_MODE (all->udiv, mode);
+  PUT_MODE (all->div_const, mode);
   PUT_MODE (all->sdiv_32, mode);
   PUT_MODE (all->smod_32, mode);
   PUT_MODE (all->wide_trunc, mode);
@@ -203,6 +205,7 @@ init_expmed_one_mode (struct init_expmed_rtl *all,
     set_shiftadd_cost (speed, mode, 0, cost);
     set_shiftsub0_cost (speed, mode, 0, cost);
     set_shiftsub1_cost (speed, mode, 0, cost);
+    set_div_const_cost (speed, mode, 0, 0);
   }
 
   n = MIN (MAX_BITS_PER_WORD, mode_bitsize);
@@ -218,6 +221,9 @@ init_expmed_one_mode (struct init_expmed_rtl *all,
 							speed));
       set_shiftsub1_cost (speed, mode, m, set_src_cost (all->shift_sub1, mode,
 							speed));
+
+      XEXP (all->div_const, 1) = all->pow2[m];
+      set_div_const_cost (speed, mode, m, set_src_cost (all->div_const, mode, speed));
     }
 
   scalar_int_mode int_mode_to;
@@ -269,6 +275,7 @@ init_expmed (void)
   all.mult = gen_rtx_MULT (mode, all.reg, all.reg);
   all.sdiv = gen_rtx_DIV (mode, all.reg, all.reg);
   all.udiv = gen_rtx_UDIV (mode, all.reg, all.reg);
+  all.div_const = gen_rtx_DIV (mode, all.reg, all.pow2[0]);
   all.sdiv_32 = gen_rtx_DIV (mode, all.reg, all.pow2[5]);
   all.smod_32 = gen_rtx_MOD (mode, all.reg, all.pow2[5]);
   all.zext = gen_rtx_ZERO_EXTEND (mode, all.reg);
@@ -323,6 +330,7 @@ init_expmed (void)
   ggc_free (all.zext);
   ggc_free (all.smod_32);
   ggc_free (all.sdiv_32);
+  ggc_free (all.div_const);
   ggc_free (all.udiv);
   ggc_free (all.sdiv);
   ggc_free (all.mult);
@@ -4382,6 +4390,9 @@ expand_divmod (int rem_flag, enum tree_code code, machine_mode mode,
 		     && INTVAL (op1) == last_div_const))
     max_cost -= (mul_cost (speed, compute_mode)
 		 + add_cost (speed, compute_mode));
+  if (op1_is_constant) {
+    max_cost = div_const_cost (speed, compute_mode, floor_log2 (INTVAL (op1)));
+  }
 
   last_div_const = ! rem_flag && op1_is_constant ? INTVAL (op1) : 0;
 
diff --git a/gcc/expmed.h b/gcc/expmed.h
index bf3c4097f33..8cafbfcea92 100644
--- a/gcc/expmed.h
+++ b/gcc/expmed.h
@@ -172,6 +172,7 @@ struct target_expmed {
   struct expmed_op_costs x_mul_cost;
   struct expmed_op_costs x_sdiv_cost;
   struct expmed_op_costs x_udiv_cost;
+  int x_div_const_cost[2][NUM_MODE_IPV_INT][MAX_BITS_PER_WORD];
   int x_mul_widen_cost[2][NUM_MODE_INT];
   int x_mul_highpart_cost[2][NUM_MODE_INT];
 
@@ -574,6 +575,32 @@ udiv_cost (bool speed, machine_mode mode)
   return *udiv_cost_ptr (speed, mode);
 }
 
+/* Subroutine of {set_,}div_const_cost.  Not to be used otherwise.  */
+
+inline int *
+div_const_cost_ptr (bool speed, machine_mode mode, int bits)
+{
+  int midx = expmed_mode_index (mode);
+  return &this_target_expmed->x_div_const_cost[speed][midx][bits];
+}
+
+/* Set the COST of doing a div_const in MODE by BITS when optimizing for SPEED.  */
+
+inline void
+set_div_const_cost (bool speed, machine_mode mode, int bits, int cost)
+{
+  *div_const_cost_ptr (speed, mode, bits) = cost;
+}
+
+/* Return the cost of doing a div_const in MODE by BITS when optimizing for
+   SPEED.  */
+
+inline int
+div_const_cost (bool speed, machine_mode mode, int bits)
+{
+  return *div_const_cost_ptr (speed, mode, bits);
+}
+
 /* Subroutine of {set_,}mul_widen_cost.  Not to be used otherwise.  */
 
 inline int *
