From 68ccebc904c1124db265ba1ec1f8d4f324801505 Mon Sep 17 00:00:00 2001
From: Denis Ivanov <denis.ivanov@cloudbear.ru>
Date: Wed, 3 Jun 2020 13:13:02 +0300
Subject: Optimize strcmp/strcpy/stlen when bitmanip extension is enabled.

Issue: CB-1297
Change-Id: I5ca52167af806108ac9daca4ed101148cbc2fc2c
---
 newlib/libc/machine/riscv/strcmp.S     | 7 +++++++
 newlib/libc/machine/riscv/sys/string.h | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/newlib/libc/machine/riscv/strcmp.S b/newlib/libc/machine/riscv/strcmp.S
index 9af9ca1f3..450ad4d69 100644
--- a/newlib/libc/machine/riscv/strcmp.S
+++ b/newlib/libc/machine/riscv/strcmp.S
@@ -35,20 +35,27 @@ strcmp:
   and   a4, a4, SZREG-1
   bnez  a4, .Lmisaligned
 
+#ifndef __riscv_zbb
 #if SZREG == 4
   li a5, 0x7f7f7f7f
 #else
   ld a5, mask
+#endif
 #endif
 
   .macro check_one_word i n
     REG_L a2, \i*SZREG(a0)
     REG_L a3, \i*SZREG(a1)
 
+#ifdef __riscv_zbb
+    // For more details see "4.1.12 Finding bytes of certain values" of bitmanip specification.
+    orc.b t0, a2
+#else
     and   t0, a2, a5
     or    t1, a2, a5
     add   t0, t0, a5
     or    t0, t0, t1
+#endif
 
     bne   t0, t2, .Lnull\i
     .if \i+1-\n
diff --git a/newlib/libc/machine/riscv/sys/string.h b/newlib/libc/machine/riscv/sys/string.h
index beebe31f7..e4172aacb 100644
--- a/newlib/libc/machine/riscv/sys/string.h
+++ b/newlib/libc/machine/riscv/sys/string.h
@@ -14,10 +14,16 @@
 
 static __inline unsigned long __libc_detect_null(unsigned long w)
 {
+#ifdef __riscv_zbb
+  // For more details see "4.1.12 Finding bytes of certain values" of bitmanip specification.
+  __asm__("orc.b %0, %0" : "+r"(w));
+  return ~w != 0;
+#else
   unsigned long mask = 0x7f7f7f7f;
   if (sizeof (long) == 8)
     mask = ((mask << 16) << 16) | mask;
   return ~(((w & mask) + mask) | w | mask);
+#endif
 }
 
 #endif
-- 
2.39.3


From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 07:50:16 +0000
Subject: riscv: add CloudBEAR 0001 erratum nop to inline-asm fsqrt

-mfix-cloudbear-0001 makes GCC emit a nop before every fdiv/fsqrt it
generates, but it cannot rewrite inline asm. __ieee754_sqrt and
__ieee754_sqrtf use inline-asm fsqrt, so add the nop explicitly. A nop
is harmless on cores without the erratum.
---
 newlib/libm/machine/riscv/e_sqrt.c  | 5 ++++-
 newlib/libm/machine/riscv/ef_sqrt.c | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/newlib/libm/machine/riscv/e_sqrt.c b/newlib/libm/machine/riscv/e_sqrt.c
index 0c5aaadf..2117d8fe 100644
--- a/newlib/libm/machine/riscv/e_sqrt.c
+++ b/newlib/libm/machine/riscv/e_sqrt.c
@@ -42,7 +42,10 @@ double
 __ieee754_sqrt (double x)
 {
 	double result;
-	asm ("fsqrt.d %0, %1" : "=f" (result) : "f" (x));
+	/* The leading nop is the CloudBEAR 0001 erratum workaround that
+	   -mfix-cloudbear-0001 emits before compiler-generated fsqrt; the
+	   compiler cannot add it to inline asm.  It is harmless elsewhere.  */
+	asm ("nop\n\tfsqrt.d %0, %1" : "=f" (result) : "f" (x));
 	return result;
 }
 
diff --git a/newlib/libm/machine/riscv/ef_sqrt.c b/newlib/libm/machine/riscv/ef_sqrt.c
index cc41813d..203b508f 100644
--- a/newlib/libm/machine/riscv/ef_sqrt.c
+++ b/newlib/libm/machine/riscv/ef_sqrt.c
@@ -42,7 +42,10 @@ float
 __ieee754_sqrtf (float x)
 {
 	float result;
-	asm ("fsqrt.s %0, %1" : "=f" (result) : "f" (x));
+	/* The leading nop is the CloudBEAR 0001 erratum workaround that
+	   -mfix-cloudbear-0001 emits before compiler-generated fsqrt; the
+	   compiler cannot add it to inline asm.  It is harmless elsewhere.  */
+	asm ("nop\n\tfsqrt.s %0, %1" : "=f" (result) : "f" (x));
 	return result;
 }
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 10:44:06 +0000
Subject: riscv: include riscv_math.h in e_sqrt.c and ef_sqrt.c

Both files test __RISCV_HARD_FLOAT, which is defined in riscv_math.h,
but never include that header. The hardware fsqrt.s/fsqrt.d path was
therefore dead code and every multilib used the generic software
square root. Include the header, as upstream newlib does, so FPU
multilibs use the (CloudBEAR 0001 guarded) fsqrt instruction.
---
 newlib/libm/machine/riscv/e_sqrt.c  | 1 +
 newlib/libm/machine/riscv/ef_sqrt.c | 1 +
 2 files changed, 2 insertions(+)

diff --git a/newlib/libm/machine/riscv/e_sqrt.c b/newlib/libm/machine/riscv/e_sqrt.c
index 2117d8fe..f6e9a90d 100644
--- a/newlib/libm/machine/riscv/e_sqrt.c
+++ b/newlib/libm/machine/riscv/e_sqrt.c
@@ -35,6 +35,7 @@
 
 #include <math.h>
 #include "math_config.h"
+#include "riscv_math.h"
 
 #if defined(__RISCV_HARD_FLOAT) && __RISCV_HARD_FLOAT >= 64
 
diff --git a/newlib/libm/machine/riscv/ef_sqrt.c b/newlib/libm/machine/riscv/ef_sqrt.c
index 203b508f..0d13f850 100644
--- a/newlib/libm/machine/riscv/ef_sqrt.c
+++ b/newlib/libm/machine/riscv/ef_sqrt.c
@@ -35,6 +35,7 @@
 
 #include <math.h>
 #include "math_config.h"
+#include "riscv_math.h"
 
 #if defined(__RISCV_HARD_FLOAT) && __RISCV_HARD_FLOAT >= 32
 
