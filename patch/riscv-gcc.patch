+/* Given that there exists variable that is set (produced)
+   by OUT_INSN and read (consumed) by IN_INSN, return true if
+   OUT_INSN represents XLEN-bit variable load operation
+   and variable loaded by OUT_INSN is used by IN_INSN as the address
+   of a load or store operation. */
+
+bool
+riscv_load_to_agu_bypass_p (rtx_insn *out_insn, rtx_insn *in_insn)
+{
+  rtx out_set = riscv_load_to_agu_bypass_p_1(out_insn);
+  rtx in_set = riscv_load_to_agu_bypass_p_1(in_insn);
+
+  if (!MEM_P (SET_DEST (in_set)) && !REG_P (SET_DEST (in_set)))
+    return false;
+
+  machine_mode mode = GET_MODE (SET_DEST (out_set));
+  if (!REG_P (SET_DEST (out_set))
+      || !(mode == DImode && TARGET_64BIT || mode == SImode && !TARGET_64BIT))
+    return false;
+
+  if (REG_P (SET_DEST (in_set))) {
+    /* IN_INSN load case */
+    return reg_mentioned_p(SET_DEST (out_set), SET_SRC(in_set));
+  } else {
+    /* IN_INSN store case */
+    return reg_mentioned_p(SET_DEST (out_set), SET_DEST(in_set));
+  }
+}
