From 9ff151099261fc65b30b1ccce0ed14f133366b59 Mon Sep 17 00:00:00 2001
From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Fri, 23 Aug 2024 15:10:41 +0300
Subject: Add gitrevs file into toolchain package

Issue: CB-4848
Change-Id: I4f39b332a413c045efbebc8a02f25ea2a8866cac
---
 Makefile.bear | 22 ++++++++++++++++++++++
 elf-win.flist |  1 +
 elf.flist     |  1 +
 linux.flist   |  1 +
 4 files changed, 25 insertions(+)

diff --git a/Makefile.bear b/Makefile.bear
index 77e3808..0321dfc 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -102,6 +102,27 @@ checkout-master:
 	cd riscv-newlib && git reset --hard && git checkout master
 	cd riscv-glibc && git checkout master
 
+GITREVS_DIR = $(TOOLCHAIN_PATH)/share/info
+$(GITREVS_DIR):
+	@mkdir -p $(GITREVS_DIR)
+
+# (1) -- submodule directory
+# (2) -- elf/linux
+define submodule_gitrev
+( \
+    git -C $(1) remote get-url origin | sed -e 's/ssh:\/\/[^\/]\+\(.\+\)/\1/g' | tr '\n' ' ' && \
+    git -C $(1) rev-parse --abbrev-ref HEAD | tr '\n' ' ' && \
+    git -C $(1) rev-parse HEAD \
+) >> $(GITREVS_DIR)/$(2).gitrevs
+
+endef
+
+update-gitrevs-elf update-gitrevs-elf-win: $(GITREVS_DIR)
+	$(foreach module,. riscv-gcc riscv-gdb riscv-binutils riscv-newlib, $(call submodule_gitrev,$(module),elf))
+
+update-gitrevs-linux: $(GITREVS_DIR)
+	$(foreach module,. riscv-gcc riscv-gdb riscv-binutils riscv-glibc, $(call submodule_gitrev,$(module),linux))
+
 # The building of riscv-gnu-toolchain on CentOS6 requires a newer version (devtoolset-7) of host GCC than
 # is installed by default. Consequently built toolchain will depend on newer than the default version of GCC libs.
 # We don't want such complicated setup (i.e. install new GCC) for toolchain users on CentOS6.
@@ -724,6 +745,7 @@ clean-riscv-gnu-toolchain-linux: \
 define top_targets
 build-$(strip $(1)):
 	+make -f Makefile.bear checkout-latest
+	+make -f Makefile.bear update-gitrevs-$(strip $(1))
 	+make -f Makefile.bear build-riscv-gnu-toolchain-$(strip $(1))
 
 clean-$(strip $(1)): clean-riscv-gnu-toolchain-$(strip $(1))
diff --git a/elf-win.flist b/elf-win.flist
index ada36da..c7e0594 100644
--- a/elf-win.flist
+++ b/elf-win.flist
@@ -94,6 +94,7 @@ debug bare-metal programs on RISC-V platforms:\n\
         "lib/gcc/riscv64-unknown-elf/12.1.0",
         "libexec/gcc/riscv64-unknown-elf/12.1.0",
         "riscv64-unknown-elf",
+        "share/info/elf.gitrevs",
         "share/riscv64-unknown-elf"
     ]
 }
diff --git a/elf.flist b/elf.flist
index 4e414a3..4206a11 100644
--- a/elf.flist
+++ b/elf.flist
@@ -89,6 +89,7 @@ debug bare-metal programs on RISC-V platforms:\n\
         "lib/gcc/riscv64-unknown-elf/12.1.0",
         "libexec/gcc/riscv64-unknown-elf/12.1.0",
