From 2e4a4d967cf9288e6998f2ac76d86022e74088da Mon Sep 17 00:00:00 2001
From: Evgeny Linsky <evgeny.linsky@cloudbear.ru>
Date: Fri, 14 Dec 2018 18:08:26 +0300
Subject: Add CFLAGS for reentrancy support.

Issue: CB-1082
Change-Id: I149a1d8ac797a9a0c8d77b0cafc734f3f3a7144e
---
 newlib/configure.host | 1 +
 1 file changed, 1 insertion(+)

diff --git a/newlib/configure.host b/newlib/configure.host
index 386183466..4073a008a 100644
--- a/newlib/configure.host
+++ b/newlib/configure.host
@@ -827,6 +827,7 @@ newlib_cflags="${newlib_cflags} -DCLOCK_PROVIDED -DMALLOC_PROVIDED -DEXIT_PROVID
 	newlib_cflags="${newlib_cflags} -DSMALL_MEMORY -D_REENT_SMALL"
 	;;
   riscv*-*-*)
+	newlib_cflags="${newlib_cflags} -D__DYNAMIC_REENT__"
 	syscall_dir=syscalls
 	;;
   sh*-*-*)
-- 
