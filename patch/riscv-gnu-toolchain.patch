From: Evgeny Linsky <evgeny.linsky@cloudbear.ru>
Date: Wed, 23 Dec 2020 15:59:41 +0300
Subject: Add target used by bear-gen for checking of files.

Issue: CB-1416
Change-Id: Ib0ed5568dbe440c3a147db375dfa83b68cbc4c8d
---
 Makefile.bear | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Makefile.bear b/Makefile.bear
index 49727a4..7a2bd10 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -75,6 +75,10 @@ checkout-8.2:  checkout-submodule-riscv-binutils_8.2 \
                checkout-submodule-riscv-newlib_8.2 \
                checkout-submodule-riscv-glibc_8.2
 
+# Don't forget to update this target after switching to new version of toolchain!
+# This target is used by bear-gen for checkouting of latest branches before cheking generated files.
+checkout-latest: checkout-10.2
+
 # git clean for gcc required for removing dirs with sources (e.g. mpfr lib), which were downloaded from filer during build
 # git reset for newlib required because libgloss/riscv/configure is overwritten.
 checkout-master:
