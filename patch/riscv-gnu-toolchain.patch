From f3ad620e0c496e7252f2cdac0f33b330d2393171 Mon Sep 17 00:00:00 2001
From: Andrey Efimov <andrey.efimov@cloudbear.ru>
Date: Thu, 13 Feb 2020 10:27:58 +0300
Subject: Added bash script for building binutils, gcc, and newlib with B
 extension support

Change-Id: I83f00f955b955812c54e6e31ff81aefd1d746f66
---
 build-bitmanip.sh | 58 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100755 build-bitmanip.sh

diff --git a/build-bitmanip.sh b/build-bitmanip.sh
new file mode 100755
index 0000000..af31590
--- /dev/null
+++ b/build-bitmanip.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+#
+##############################################################################
+#
+# @brief Build binutils, gcc, and newlib with B extension support
+#
+# @author andrey.efimov@cloudbear.ru
+#
+# Copyright (c) 2020 CloudBEAR LLC, all rights reserved.
+# THIS PROGRAM IS AN UNPUBLISHED WORK FULLY PROTECTED BY COPYRIGHT LAWS AND
+# IS CONSIDERED A TRADE SECRET BELONGING TO THE CLOUDBEAR LLC.
+#
+##############################################################################
+
+nproc=4
+
+# Merge from upstream
+# ../scripts/clone-upstream.sh riscv-gcc https://github.com/riscv/riscv-gcc.git riscv-bitmanip
+# ../scripts/clone-upstream.sh riscv-binutils https://github.com/riscv/riscv-binutils-gdb.git riscv-bitmanip
+# newlib for bitmanip is idential to what we use (3.0.0)
+
+cd riscv-binutils; git fetch; git checkout origin/upstream/riscv-bitmanip/2020ww07; cd -
+cd riscv-gcc; git fetch; git checkout origin/upstream/riscv-bitmanip/2020ww07; cd -
+cd riscv-newlib; git fetch; git checkout master; cd -
+
+# From riscv-bitmanip/tools/riscv-binutils-build.sh
+# About 2 minutes to build with -j4
+
+rm -rf riscv-binutils-build
+mkdir -p riscv-binutils-build
+cd riscv-binutils-build
+../riscv-binutils/configure --prefix=$RISCV/riscv64b --target=riscv64-unknown-elf > configure.log
+make -j$(nproc) > build.log
+make install > install.log
+cd -
+
+# From riscv-bitmanip/tools/riscv-gcc-build.sh
+# About 4 minutes to build with -j4
+
+rm -rf riscv-gcc-build
+mkdir -p riscv-gcc-build
+cd riscv-gcc-build
+../riscv-gcc/configure --prefix=$RISCV/riscv64b --target=riscv64-unknown-elf --enable-languages=c --disable-libssp > configure.log
+make -j$(nproc) > build.log
+make install > install.log
+cd -
+
+# From riscv-bitmanip/tools/riscv-newlib-build.sh
+# About 3 minutes to build with -j4
+
+rm -rf riscv-newlib-build
+mkdir -p riscv-newlib-build
+cd riscv-newlib-build
+export PATH="$RISCV/riscv64b/bin:$PATH"
+../riscv-newlib/configure --prefix=$RISCV/riscv64b --target=riscv64-unknown-elf > configure.log
+make -j$(nproc) > build.log
+make install > install.log
+cd -
-- 
2.39.3


From 3a20a0a69ac421fcc97f27b9401da724552c801c Mon Sep 17 00:00:00 2001
From: Evgeny Linsky <evgeny.linsky@cloudbear.ru>
Date: Wed, 4 Mar 2020 16:29:00 +0300
Subject: Add 9.2 elf compiler.

Submodules without patches (binutils) are checkouted on master (incorrect).
Submodules with patches (gcc, newlib) are checkouted to correct branches.

Commiting plan:
1. Commit with commented checkout to new branches.
2. Update, uncomment checkout and commit again.

Issue: CB-1187
Change-Id: I147421e7e7b7e3268d91bc261069ca82f5093a00
---
 Makefile.elf-win.bear | 170 +++++++++++++++++++++++++++++++++++
 Makefile.elf.bear     | 205 ++++++++++++++++++++++++++++++++++++++++++
 elf-win.flist         |   9 +-
 elf.flist             |   9 +-
 4 files changed, 381 insertions(+), 12 deletions(-)
 create mode 100644 Makefile.elf-win.bear
 create mode 100644 Makefile.elf.bear

diff --git a/Makefile.elf-win.bear b/Makefile.elf-win.bear
new file mode 100644
index 0000000..d8997c8
--- /dev/null
+++ b/Makefile.elf-win.bear
@@ -0,0 +1,170 @@
+##############################################################################
+#
+# @brief Rules for building riscv64-unknown-elf for Windows
+#
+# @author evgeny.linsky@cloudbear.ru
+#
+# Copyright (c) 2020 CloudBEAR LLC, all rights reserved.
+# THIS PROGRAM IS AN UNPUBLISHED WORK FULLY PROTECTED BY COPYRIGHT LAWS AND
+# IS CONSIDERED A TRADE SECRET BELONGING TO THE CLOUDBEAR LLC.
+#
+##############################################################################
+
+CFLAGS_FOR_TARGET :=  -mcmodel=medany
+CXXFLAGS_FOR_TARGET := -mcmodel=medany
+O_ELF = -Os
+
+# tag for riscv-gcc: releases/gcc-9.2.0
+# tag for newlib: newlib-3.2.0
+checkout-9.2:
+	cd riscv-binutils && git fetch --tags && git checkout binutils-2_33
+	cd riscv-gcc && git fetch && git checkout new_master
+	cd riscv-newlib && git fetch && git checkout new_master_2020
+
+# git clean required for removing prerequisites
+checkout-8.2:
+	cd riscv-binutils && git checkout master
+	cd riscv-gcc && git clean -fdx && git checkout master
+	cd riscv-newlib && git checkout master
+#
+# Newlib
+#
+
+# the same options as for riscv64-unknown-elf
+# except:
+# --with-host=x86_64-w64-mingw32
+#    On, reason: compiler will be executed on Windows
+# LDFLAGS=-static
+#    Avoid problems with *.so on Windows
+
+build-riscv-binutils-win:
+	rm -rf riscv-binutils-win-build
+	mkdir -p riscv-binutils-win-build
+	cd riscv-binutils-win-build && ../riscv-binutils/configure \
+        --target=riscv64-unknown-elf \
+        --host=x86_64-w64-mingw32 \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --includedir=$(TOOLCHAIN_PATH)/include/riscv64-unknown-elf \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --with-expat \
+        --disable-libreadline \
+        > configure.log
+	+make -C riscv-binutils-win-build LDFLAGS=-static > riscv-binutils-win-build/build.log
+	+make -C riscv-binutils-win-build install > riscv-binutils-win-build/install.log
+
+clean-riscv-binutils-win:
+	rm -rf riscv-binutils-win-build
+
+build-riscv-gcc-elf-win-stage1:
+	rm -rf riscv-gcc-elf-win-build
+	mkdir -p riscv-gcc-elf-win-build
+	cd riscv-gcc-elf-win-build && ../riscv-gcc/configure \
+        --target=riscv64-unknown-elf \
+        --host=x86_64-w64-mingw32 \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --disable-shared \
+        --disable-threads \
+        --disable-tls \
+        --enable-languages=c,c++ \
+        --with-system-zlib \
+        --with-newlib \
+        --with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+        --disable-libmudflap \
+        --disable-libssp \
+        --disable-libquadmath \
+        --disable-libgomp \
+        --disable-nls \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure-stage1.log
+	+make -C riscv-gcc-elf-win-build all-gcc LDFLAGS=-static > riscv-gcc-elf-win-build/build-stage1.log
+	+make -C riscv-gcc-elf-win-build install-gcc > riscv-gcc-elf-win-build/install-stage1.log
+
+build-riscv-gcc-elf-win-stage2:
+	rm -rf riscv-gcc-elf-win-build
+	mkdir -p riscv-gcc-elf-win-build
+	cd riscv-gcc-elf-win-build && ../riscv-gcc/configure \
+        --target=riscv64-unknown-elf \
+        --host=x86_64-w64-mingw32 \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --disable-shared \
+        --disable-threads \
+        --enable-tls \
+        --enable-languages=c,c++ \
+        --with-system-zlib \
+        --with-newlib \
+        --with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+        --with-native-system-header-dir=/include \
+        --disable-libmudflap \
+        --disable-libssp \
+        --disable-libquadmath \
+        --disable-libgomp \
+        --disable-nls \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure-stage1.log
+	+make -C riscv-gcc-elf-win-build LDFLAGS=-static > riscv-gcc-elf-win-build/build-stage2.log
+	+make -C riscv-gcc-elf-win-build install > riscv-gcc-elf-win-build/install-stage2.log
+
+clean-riscv-gcc-elf-win:
+	rm -rf riscv-gcc-elf-win-build
+
+build-riscv-newlib-win:
+	rm -rf riscv-newlib-win-build
+	mkdir -p riscv-newlib-win-build
+	cd riscv-newlib-win-build && ../riscv-newlib/configure \
+        --target=riscv64-unknown-elf \
+        --host=x86_64-w64-mingw32 \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --enable-newlib-io-long-long \
+        --enable-newlib-io-c99-formats \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure.log
+	+make -C riscv-newlib-win-build > riscv-newlib-win-build/build.log
+	+make -C riscv-newlib-win-build install > riscv-newlib-win-build/install.log
+
+clean-riscv-newlib-win:
+	rm -rf riscv-newlib-win-build
+
+# 1. gmp, isl, mpc, mpfr libs in sources (stored on /mnt) are required for building
+#    of riscv-windows-compiler.
+# 2. download_prerequisites scripts by default does not download libs again, if they exist, but
+#    it unpacks libs and sets appropriate symbol links.
+copy-riscv-gnu-toolchain-elf-win-prerequisites:
+	cp -r /mnt/filer/bear/soft/riscv-gcc-prerequisites/*.tar.* riscv-gcc
+	cd riscv-gcc && contrib/download_prerequisites
+
+# check if Linux of riscv64-unknown-elf-gcc exists in path.
+# NO_GCC_ELF_LINUX ?= $(shell which riscv64-unknown-elf-gcc >/dev/null>/dev/null 2>/dev/null; echo $$?)
+
+# for the first time let's guarantee usage of GCC 9.2 Linux for GCC 9.2 Windows
+NO_GCC_ELF_LINUX := 1
+
+# riscv-linux-compiler (from opt) is required for building libs (libc etc), because already built
+# riscv-windows-compiler could not be executed for this purpose in Linux.
+build-riscv-gnu-toolchain-elf-win:
+ifeq ($(NO_GCC_ELF_LINUX),1)
+	+make -f Makefile.elf.bear build-riscv-gnu-toolchain-elf
+endif
+	+make -f Makefile.elf-win.bear copy-riscv-gnu-toolchain-elf-win-prerequisites
+	+make -f Makefile.elf-win.bear build-riscv-binutils-win
+	+make -f Makefile.elf-win.bear build-riscv-gcc-elf-win-stage1
+	+make -f Makefile.elf-win.bear build-riscv-newlib-win
+	+make -f Makefile.elf-win.bear build-riscv-gcc-elf-win-stage2
+
+clean-riscv-gnu-toolchain-elf-win: clean-riscv-binutils-win clean-riscv-gcc-elf-win clean-riscv-newlib-win
+
+build:
+#	+make -f Makefile.elf-win.bear checkout-9.2
+	+make -f Makefile.elf-win.bear build-riscv-gnu-toolchain-elf-win
+	+make -f Makefile.elf-win.bear checkout-8.2
+
+clean: clean-riscv-gnu-toolchain-elf-win
+
