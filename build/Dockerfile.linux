# Portable Linux build environment for the NIIET RISC-V baremetal toolchain.
#
# manylinux2014 = CentOS 7 / glibc 2.17, so host binaries produced here run on
# RHEL/CentOS 7 and every newer Linux ("build old, run everywhere"). It already
# carries devtoolset-10 on PATH (modern C++17 GCC linked against that old glibc)
# plus a recent cmake + ninja for the LLVM build. The C++ runtime is statically
# linked by build-baremetal.sh (-static-libstdc++ -static-libgcc) so the binaries
# don't need a new libstdc++.so either.
#
# The Windows canadian-cross runs on the Ubuntu runner directly (Linux-hosted
# mingw GCC 13), NOT in this image — so no mingw here.
#
# Build (context = build/ so the setup script is available to COPY):
#   docker build -t niiet-rv-linux -f build/Dockerfile.linux build/
#
# Run (from the repo root):
#   docker run --rm \
#     -v "$PWD":/src -v /tmp/rv-patch-verify:/sources \
#     -v rv-work:/work -v rv-prefix:/opt/riscv -v /tmp/rv-out:/out \
#     niiet-rv-linux bash -c '/src/build/build-baremetal.sh all'
#
FROM quay.io/pypa/manylinux2014_x86_64

COPY setup-manylinux2014.sh /tmp/setup-manylinux2014.sh
RUN bash /tmp/setup-manylinux2014.sh && rm -f /tmp/setup-manylinux2014.sh

# In CI the bind-mounted source/build dirs are owned by the host user, but the
# container runs as root (uid mismatch) -> git refuses with "dubious ownership".
# The build runs git inside /src and the source trees, so allow any path.
RUN git config --system --add safe.directory '*'

SHELL ["/bin/bash", "-c"]
