From a987c4ac67f5d825fe202eee357c954d76346fac Mon Sep 17 00:00:00 2001
From: Evgeny Linsky <evgeny.linsky@cloudbear.ru>
Date: Fri, 26 Nov 2021 16:19:03 +0300
Subject: Fix for building toolchain for windows on Fedora 35.

Change-Id: I3021f15f432edb1f597b2945b524bc07505de7fc
---
 Makefile.bear | 18 +++++++-----------
 elf-win.flist |  1 +
 2 files changed, 8 insertions(+), 11 deletions(-)

diff --git a/Makefile.bear b/Makefile.bear
index 99d645b..aa697da 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -33,18 +33,17 @@ ifneq ($(BUILD_FOR),windows)
 # Build for Linux - no extra flags
 HOST =
 HOST_LDFLAGS =
-BINUTILS_LDFLAGS =
 else
 # Build for Windows:
 # --with-host=x86_64-w64-mingw32
 #	Compiler will be executed on Windows
 # LDFLAGS=-static
 #	Avoid problems with *.so on Windows
-# LDFLAGS=-static for binutils is not enough. See CB-1296
-#   So LDFLAGS=-all-static for binutils.
+# LDFLAGS="/usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll"
+#	Building gdb and binutils for windows on Fedora 35 produces errors: undefined reference to `__strcpy_chk'
+#	Fix from: https://www.mail-archive.com/mingw@lists.fedoraproject.org/msg07672.html
 HOST = --host=x86_64-w64-mingw32
-HOST_LDFLAGS = -static
-BINUTILS_LDFLAGS = -all-static
+HOST_LDFLAGS = "-static /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll"
 endif
 
 # Simple function for getting i-th word from '_'-separated string.
@@ -158,12 +157,7 @@ build-riscv-binutils:
 			> configure.log && \
 		touch ../riscv-binutils/intl/plural.c ; \
 	fi
-ifeq ($(BINUTILS_LDFLAGS),-all-static)
-# This forces all the subdirectories to be configured immediately. A statically linked build will fail without it.
-# See CB-1296
-	+make -C riscv-binutils-build-$(HOST) configure-host > riscv-binutils-build-$(HOST)/configure-host.log
-endif
-	+make -C riscv-binutils-build-$(HOST) LDFLAGS=$(BINUTILS_LDFLAGS) > riscv-binutils-build-$(HOST)/build.log
+	+make -C riscv-binutils-build-$(HOST) LDFLAGS=$(HOST_LDFLAGS) > riscv-binutils-build-$(HOST)/build.log
 	+make -C riscv-binutils-build-$(HOST) install > riscv-binutils-build-$(HOST)/install.log
 
 clean-riscv-binutils:
@@ -394,8 +388,10 @@ endif
 clean-riscv-gnu-toolchain-elf: \
 	clean-riscv-binutils clean-riscv-gdb clean-riscv-gcc-elf clean-riscv-newlib
 
+# libssp-0.dll is required by executables for windows (see HOST_LDFLAGS)
 build-riscv-gnu-toolchain-elf-win:
 	+make -f Makefile.bear build-riscv-gnu-toolchain-elf BUILD_FOR=windows
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll $(RISCV)/bin
 
 clean-riscv-gnu-toolchain-elf-win:
 	+make -f Makefile.bear clean-riscv-gnu-toolchain-elf BUILD_FOR=windows
diff --git a/elf-win.flist b/elf-win.flist
index 04b8cd9..eb68a96 100644
--- a/elf-win.flist
+++ b/elf-win.flist
@@ -84,6 +84,7 @@ debug bare-metal programs on RISC-V platforms:\n\
         "bin/riscv64-unknown-elf-gcc-ar.exe",
         "bin/riscv64-unknown-elf-c++.exe",
         "bin/riscv64-unknown-elf-gcc-11.1.0.exe",
+        "bin/libssp-0.dll",
         "lib/gcc/riscv64-unknown-elf/11.1.0",
         "libexec/gcc/riscv64-unknown-elf/11.1.0",
         "riscv64-unknown-elf",
-- 
