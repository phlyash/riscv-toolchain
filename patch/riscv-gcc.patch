+/* Helper function for riscv_load_to_agu_bypass_p. */
+
+static rtx
+riscv_load_to_agu_bypass_p_1(rtx_insn *insn)
+{
+  rtx side_effects = single_set(insn);
+  if (side_effects)
+    return side_effects;
+
+  rtx patt = PATTERN(insn);
+  if (GET_CODE (patt) != PARALLEL)
+    return NULL;
+
+  for (int i = 0; i < XVECLEN (patt, 0); i++)
+    {
+      rtx expr = XVECEXP(patt, 0, i);
+      if (GET_CODE (expr) == CLOBBER || GET_CODE (expr) == USE)
+	continue;
+      gcc_assert (GET_CODE (expr) == SET);
+      return expr;
+    }
+
+  return NULL;
+}
