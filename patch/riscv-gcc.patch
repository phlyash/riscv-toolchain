+   (match_scratch:X 5 "r")
+   (set (match_operand:X 0 "register_operand")
+	(if_then_else:X (eq:X (match_operand:X 1 "register_operand") (const_int 0))
 			 (const_int 0)
-			 (match_operand:DI 2 "register_operand")))
+			 (match_operand:X 2 "register_operand")))
    (set (match_dup 0)
-	(xor:DI (match_dup 0) (match_operand:DI 3 "register_operand")))
+	(xor:X (match_dup 0) (match_operand:X 3 "register_operand")))
    (match_dup 5)
-   (set (match_dup 0) (zero_extend:DI (match_operand:HI 4 "register_operand")))]
-  "TARGET_64BIT
-   && TARGET_ZICOND_LIKE
-   && TARGET_ZBB
+   (set (match_dup 0) (zero_extend:X (match_operand:HI 4 "register_operand")))]
+  "TARGET_ZICOND_LIKE && TARGET_ZBB
    && REGNO (operands[0]) == REGNO (operands[4])
    && check_reg_holds_hi_value (peep2_next_insn(0), operands[3])"
   [
