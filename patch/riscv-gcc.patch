 #endif
 
 extern bool riscv_use_divmod_expander (void);
diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 01a80dcc68f..40f4d7fdc37 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -8539,6 +8539,48 @@ riscv_load_to_agu_bypass_p (rtx_insn *out_insn, rtx_insn *in_insn)
   }
 }
 
+bool
+check_reg_holds_hi_value_1 (rtx_insn *cur, rtx reg, int rec_limit)
+{
+    df_ref def;
+    unsigned int regno = REGNO (reg);
+    rtx_insn *cur_bb_head = BB_HEAD (BLOCK_FOR_INSN (cur));
+
+    // Searching last reg definition in basic block
+    for (rtx_insn *i = PREV_INSN (cur); i && i != PREV_INSN (cur_bb_head); i = PREV_INSN (i))
+    {
+      if (!INSN_P (i))
+	continue;
+
+      FOR_EACH_INSN_DEF (def, i)
+	if (DF_REF_REGNO (def) == regno)
+	  {
+	    // Definition found
+	    rtx def_set = single_set (DF_REF_INSN (def));
+	    return def_set
+		   && ((GET_CODE (SET_SRC (def_set)) == UNSPEC
+		        && XINT (SET_SRC (def_set), 1) == UNSPEC_XBEAR_CRC_PEEPHOLE)
+		      || (GET_CODE (SET_SRC (def_set)) == ZERO_EXTEND
+			  && GET_MODE (XEXP (SET_SRC (def_set), 0)) == HImode)
+		      || (GET_CODE (SET_SRC (def_set)) == ZERO_EXTEND
+			  && GET_CODE (XEXP (SET_SRC (def_set), 0)) == LSHIFTRT
+			  && rec_limit >= 1
+			  && check_reg_holds_hi_value_1 (DF_REF_INSN (def)
+							 , XEXP (XEXP (SET_SRC (def_set), 0), 0)
+							 , rec_limit - 1)));
+	  }
+    }
+
+    return false;
+}
+
+bool
+check_reg_holds_hi_value (rtx_insn *cur, rtx reg)
+{
+  return check_reg_holds_hi_value_1 (cur, reg, 1);
+}
