+++ b/linux.flist
@@ -92,6 +92,7 @@ linux programs on RISC-V platforms:\n\
         "bin/riscv64-unknown-linux-gnu-size",
         "lib/gcc/riscv64-unknown-linux-gnu/12.1.0",
         "libexec/gcc/riscv64-unknown-linux-gnu/12.1.0",
