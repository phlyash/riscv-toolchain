Subject: Add BEAR macro-op FUSEs for bxx72

Issue: CB-4831
Change-Id: Ib7665649c6b9f8147e9b99af1fcb7cb9feff9a85
---
 gcc/config/riscv/riscv.cc | 66 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 63 insertions(+), 3 deletions(-)

diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 4523a110951..66bcc72d273 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -270,6 +270,8 @@ enum riscv_fusion_pairs
   RISCV_FUSE_AUIPC_LD = (1 << 7),
   RISCV_FUSE_LDPREINCREMENT = (1 << 8),
   RISCV_FUSE_ALIGNED_STD = (1 << 9),
+  BEAR_FUSE_AND_BEQ = (1 << 30),
+  BEAR_FUSE_SHADD_LD = (1 << 31),
 };
 
 /* Costs of various operations on the different architectures.  */
@@ -462,9 +464,9 @@ static const struct riscv_tune_param bxx72_tune_info = {
   8,						/* fmv_cost */
   true,						/* slow_unaligned_access */
   false,					/* use_divmod_expansion */
-  RISCV_FUSE_LDINDEXED | RISCV_FUSE_LUI_ADDI \
-  | RISCV_FUSE_AUIPC_ADDI | RISCV_FUSE_LUI_LD \
-  | RISCV_FUSE_AUIPC_LD,		/* fusible_ops */
+  RISCV_FUSE_LDINDEXED | RISCV_FUSE_LUI_ADDI | RISCV_FUSE_AUIPC_ADDI \
+  | RISCV_FUSE_LUI_LD  | RISCV_FUSE_AUIPC_LD | RISCV_FUSE_LDPREINCREMENT \
+  | BEAR_FUSE_AND_BEQ | BEAR_FUSE_SHADD_LD,		/* fusible_ops */
   NULL,						/* vector cost */
 };
 
@@ -9024,6 +9026,64 @@ riscv_macro_fusion_pair_p (rtx_insn *prev, rtx_insn *curr)
 	}
     }
 
+  if (prev_set && any_condjump_p (curr) && riscv_fusion_enabled_p (BEAR_FUSE_AND_BEQ))
+    {
+      /* We are trying to match the following patterns:
+	   prev (andi) == (set (reg rD) (and (reg rS) (const_int IMM12)))
+	   curr (b*z)  == (set (pc) (if_then_else (ne/eq/lt/gt... (reg rD) (const_int 0)) (label_ref:DI 68) (pc)))
+	 and
+	   prev (and)  == (set (reg rD) (and (reg rS1) (reg rS2)))
+	   curr (b*z)  == (set (pc) (if_then_else (ne/eq/lt/gt... (reg rD) (const_int 0)) (label_ref:DI 68) (pc))) */
+      rtx prev_src = SET_SRC (prev_set);
+      rtx branch_cond = XEXP (SET_SRC (pc_set (curr)), 0);
+      if (GET_CODE (prev_src) == AND
+	  && REG_P (XEXP (prev_src, 0))
+	  && (REG_P (XEXP (prev_src, 1))
+	      || SMALL_OPERAND (INTVAL (XEXP (prev_src, 1))))
+	  && CONST_INT_P (XEXP (branch_cond, 1))
+	  && INTVAL (XEXP (branch_cond, 1)) == 0
+	  && REGNO (SET_DEST (prev_set)) == REGNO (XEXP (branch_cond, 0))
+	  && (GET_CODE (branch_cond) == EQ
+	      || GET_CODE (branch_cond) == NE
+	      || GET_CODE (branch_cond) == LT
+	      || GET_CODE (branch_cond) == LTU
+	      || GET_CODE (branch_cond) == GT
+	      || GET_CODE (branch_cond) == GTU))
+	return true;
+    }
+
+  if (simple_sets_p && riscv_fusion_enabled_p (BEAR_FUSE_SHADD_LD))
+    {
+      rtx prev_src = SET_SRC (prev_set);
+      rtx curr_src = SET_SRC (curr_set);
+
+      /* We are trying to match the following:
+	 prev (shNadd) == (set (reg rS) */
+      if (GET_CODE (prev_src) == PLUS
+	  && GET_CODE (XEXP (prev_src, 0)) == ASHIFT
+	  && REG_P (XEXP (XEXP (prev_src, 0), 0))
+	  && CONST_INT_P (XEXP (XEXP (prev_src, 0), 1))
+	  && IN_RANGE (INTVAL (XEXP (XEXP (prev_src, 0), 1)), 1, 3))
+	{
+	  /* We are trying to match the following:
+	     curr (ld)  == (set (reg rD) (mem (reg rS))) */
+	  if (MEM_P (curr_src)
+	      && REG_P (XEXP (curr_src, 0))
+	      && REGNO (SET_DEST (curr_set)) == REGNO (XEXP (curr_src, 0))
+	      && REGNO (XEXP (curr_src, 0)) == REGNO (SET_DEST (prev_set)))
+	    return true;
+
+	  /* We are trying to match the following:
+	     curr (ld)  == (set (reg rD) (any_extend (mem (reg rS)))) */
+	  if ((GET_CODE (curr_src) == SIGN_EXTEND || (GET_CODE (curr_src) == ZERO_EXTEND))
+	      && MEM_P (XEXP (curr_src, 0))
+	      && REG_P (XEXP (XEXP (SET_SRC (curr_set), 0), 0))
+	      && REGNO (SET_DEST (curr_set)) == REGNO (XEXP (XEXP (SET_SRC (curr_set), 0), 0))
+	      && REGNO (XEXP (XEXP (SET_SRC (curr_set), 0), 0)) == REGNO (SET_DEST (prev_set)))
+	    return true;
+	}
+    }
+
   return false;
 }
 
