---
 Makefile.bear | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile.bear b/Makefile.bear
index 87f3bff..23e6ca8 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -51,10 +51,10 @@ get-word = $(word $2,$(subst _, ,$1))
 # Checkout version branch if now it at master (even in detached state), otherwise keep current branch.
 #   grep: -w = exact match.
 checkout-submodule-%:
-	cd $(call get-word, $*, 1) && \
+	@cd $(call get-word, $*, 1) && \
         if git branch --contains HEAD | grep -w master; \
         then \
-            echo "$(call get-word, $*, 1) in master, so checkouting $(call get-word, $*, 2)."; \
+            echo "$(call get-word, $*, 1) in master, so checking out $(call get-word, $*, 2)."; \
             git fetch origin $(call get-word, $*, 2):$(call get-word, $*, 2) && git checkout $(call get-word, $*, 2); \
         else \
             echo "$(call get-word, $*, 1) NOT in master, so holding current branch."; \
-- 
