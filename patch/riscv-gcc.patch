+++ b/gcc/config/riscv/riscv-target-attr.cc
@@ -43,12 +43,14 @@ public:
     , m_loc (loc)
     , m_cpu_info (nullptr)
     , m_tune (nullptr)
+    , fix_cloudbear_flags (0)
   {
   }
 
   bool handle_arch (const char *);
   bool handle_cpu (const char *);
   bool handle_tune (const char *);
+  bool handle_fix_cloudbear (const char *);
 
   void set_loc (location_t loc) {
     m_loc = loc;
@@ -70,6 +72,7 @@ private:
   location_t m_loc;
   const  riscv_cpu_info *m_cpu_info;
   const char *m_tune;
+  unsigned int fix_cloudbear_flags;
 };
 }
 
@@ -88,6 +91,7 @@ struct riscv_attribute_info
 static const struct riscv_attribute_info riscv_attributes[]
   = {{"arch", &riscv_target_attr_parser::handle_arch},
      {"cpu", &riscv_target_attr_parser::handle_cpu},
+     {"fix_cloudbear", &riscv_target_attr_parser::handle_fix_cloudbear},
      {"tune", &riscv_target_attr_parser::handle_tune}};
 
 bool
@@ -164,6 +168,18 @@ riscv_target_attr_parser::handle_arch (const char *str)
   return parse_arch (str);
 }
 
+bool
+riscv_target_attr_parser::handle_fix_cloudbear (const char *str)
+{
+  if (!strcmp (str, "0001")) {
+      fix_cloudbear_flags |= MASK_CB_ERRATUM_0001;
+  } else {
+      error_at (m_loc, "%<target()%> attribute: unrecognized value for fix_cloudbear");
+  }
+
+  return true;
+}
+
 /* Handle the CPU_STR argument to the cpu= target attribute.  */
 
 bool
@@ -229,6 +245,8 @@ riscv_target_attr_parser::update_settings (struct gcc_options *opts) const
       if (m_cpu_info)
 	opts->x_riscv_tune_string = m_cpu_info->tune;
     }
+
+  opts->x_target_flags |= fix_cloudbear_flags;
 }
 
 /* Parse ARG_STR which contains the definition of one target attribute.
diff --git a/gcc/config/riscv/riscv.h b/gcc/config/riscv/riscv.h
index 2c75a137a75..5b6418af9d4 100644
--- a/gcc/config/riscv/riscv.h
+++ b/gcc/config/riscv/riscv.h
@@ -926,6 +926,9 @@ extern enum riscv_cc get_riscv_cc (const rtx use);
    && (riscv_microarchitecture == bxx52 \
        || riscv_microarchitecture == bxx72))
 
+/* See issue: CB-5802 */
+#define ADD_NOP_FOR_CB_0001_ERRATUM(out_template) ("nop\n\t" out_template + (TARGET_CB_ERRATUM_0001 ? 0 : 5))
+
 #define LOGICAL_OP_NON_SHORT_CIRCUIT 0
 
 /* Control the assembler format that we output.  */
diff --git a/gcc/config/riscv/riscv.md b/gcc/config/riscv/riscv.md
index 614a35ebdba..bccf08fef6c 100644
--- a/gcc/config/riscv/riscv.md
+++ b/gcc/config/riscv/riscv.md
@@ -1317,7 +1317,9 @@
 	(any_div:SI (match_operand:SI 1 "register_operand" " r")
 		    (match_operand:SI 2 "register_operand" " r")))]
   "TARGET_DIV"
-  "<insn>%i2%~\t%0,%1,%2"
+{
+  return ADD_NOP_FOR_CB_0001_ERRATUM("<insn>%i2\t%0,%1,%2");
+}
   [(set_attr "type" "idiv")
    (set_attr "mode" "SI")])
 
@@ -1379,7 +1381,9 @@
 	(div:ANYF (match_operand:ANYF 1 "register_operand" " f")
 		  (match_operand:ANYF 2 "register_operand" " f")))]
   "(TARGET_HARD_FLOAT || TARGET_ZFINX) && TARGET_FDIV"
-  "fdiv.<fmt>\t%0,%1,%2"
+{
+  return ADD_NOP_FOR_CB_0001_ERRATUM("fdiv.<fmt>\t%0,%1,%2");
+}
   [(set_attr "type" "fdiv")
    (set_attr "mode" "<UNITMODE>")])
 
@@ -1395,7 +1399,7 @@
 	(sqrt:ANYF (match_operand:ANYF 1 "register_operand" " f")))]
   "(TARGET_HARD_FLOAT || TARGET_ZFINX) && TARGET_FDIV"
 {
-    return "fsqrt.<fmt>\t%0,%1";
+  return ADD_NOP_FOR_CB_0001_ERRATUM("fsqrt.<fmt>\t%0,%1");
 }
   [(set_attr "type" "fsqrt")
    (set_attr "mode" "<UNITMODE>")])
diff --git a/gcc/config/riscv/riscv.opt b/gcc/config/riscv/riscv.opt
index 420d67b7034..8a3afb9be28 100644
--- a/gcc/config/riscv/riscv.opt
+++ b/gcc/config/riscv/riscv.opt
@@ -106,6 +106,11 @@ mcpu=
 Target RejectNegative Joined Var(riscv_cpu_string) Save
 -mcpu=PROCESSOR	Use architecture of and optimize the output for PROCESSOR.
 
+mfix-cloudbear-0001
+Target Mask(CB_ERRATUM_0001)
+Avoid sequencing iterative instruction after associated load, that may trigger
+erratum when load operand resides in flash memory.
+
 msmall-data-limit=
 Target Joined UInteger Var(g_switch_value) Init(8)
 -msmall-data-limit=N	Put global and static data smaller than <number> bytes into a special section (on some targets).
