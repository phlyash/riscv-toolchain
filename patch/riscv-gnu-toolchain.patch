new file mode 100644
index 0000000..cd09889
--- /dev/null
+++ b/Makefile.elf.bear
@@ -0,0 +1,205 @@
+##############################################################################
+#
+# @brief Rules for building riscv64-unknown-elf
+#
+# @author evgeny.linsky@cloudbear.ru
+#
+# Copyright (c) 2020 CloudBEAR LLC, all rights reserved.
+# THIS PROGRAM IS AN UNPUBLISHED WORK FULLY PROTECTED BY COPYRIGHT LAWS AND
+# IS CONSIDERED A TRADE SECRET BELONGING TO THE CLOUDBEAR LLC.
+#
+##############################################################################
+
+# -Os:
+#	 Error during build of tests
+#    (e.g. coremark for rv32imc-pcmx, section `.text' will not fit in region `TCM_A')
+CFLAGS_FOR_TARGET :=  -mcmodel=medany
+CXXFLAGS_FOR_TARGET := -mcmodel=medany
+O_ELF = -Os
+
+# tag for riscv-gcc: releases/gcc-9.2.0
+# tag for newlib: newlib-3.2.0
+checkout-9.2:
+	cd riscv-binutils && git fetch --tags && git checkout binutils-2_33
+#	cd riscv-gcc && git fetch && git checkout new_master
+#	cd riscv-newlib && git fetch && git checkout new_master_2020
+
+checkout-8.2:
+	cd riscv-binutils && git checkout master
+	cd riscv-gcc && git checkout master
+	cd riscv-newlib && git checkout master
+
+#
+# Newlib
+#
+# --datarootdir= --includedir=
+#    On, reason: we have two compilers (elf, linux), so their files should copied to different directories
+#    (dir name depends on compiler)
+# --with-expat
+#    On, reason: is required to enable XML support used by OpenOCD
+#--disable-libdecnumber
+#    Disable library for decimal floating point numbers
+#    Skip, reason: fatal error: gstdint.h: No such file or directory
+#--disable-readline
+#    Disable library for line editing enhanced capabilities like history
+#    On, reason: speed up compilation
+build-riscv-binutils:
+	rm -rf riscv-binutils-build
+	mkdir -p riscv-binutils-build
+	cd riscv-binutils-build && ../riscv-binutils/configure \
+        --target=riscv64-unknown-elf \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --includedir=$(TOOLCHAIN_PATH)/include/riscv64-unknown-elf \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --with-expat=yes \
+        --disable-libreadline \
+        > configure.log
+	+make -C riscv-binutils-build > riscv-binutils-build/build.log
+	+make -C riscv-binutils-build install > riscv-binutils-build/install.log
+
+clean-riscv-binutils:
+	rm -rf riscv-binutils-build
+
+# --datarootdir=
+#   On, reason: we have two compilers (elf, linux), so their files should copied to different
+#   directories (dir name depends on compiler)
+# --disable-shared
+#    Disable shared libraries
+#    On, reason:
+# --disable-threads
+#    Specify that threading support should be disabled for the system.
+#    On, reason:
+# --disable-tls
+#    Specify that the target does not support TLS.
+#    On, reason:
+# --with-system-zlib
+#    Use installed ‘zlib’ rather than that included with GCC.
+#    On, reason:
+# --with-newlib
+#    On, reason: we would like to use newlib
+#    configure: error: No support for this host/target combination.
+#    make[1]: *** [configure-target-libstdc++-v3] Error 1
+# --with-sysroot=
+#    Tells GCC to consider dir as the root of a tree that contains a (subset of)
+#    the root filesystem of the target operating system. Target system headers,
+#    libraries and run-time object files will be searched in there.
+#    On, reason:
+# --disable-libmudflap
+#    Skip, reason: The mudflap run time checker was removed in GCC 4.9 and it is superseded by Address Sanitizer.
+# --disable-libssp
+#    Stack smashing protection
+#    On, reason: speed up program execution
+#    error: unknown type name ‘size_t’
+# --disable-libquadmath
+#    128 bit math
+#    On, reason: speed up compilation
+# --libgomp
+#    OpenMP
+#    On, reason: speed up compilation
+#--disable-nls
+#    The --enable-nls option enables Native Language Support (NLS),
+#    which lets GCC output diagnostics in languages other than American English.
+#    Native Language Support is enabled by default if not doing a canadian cross build.
+#    The --disable-nls option disables NLS.
+#    On, reason: nls is strange feature
+#--src=
+#    Skip, reason: description not found in documentation
+#
+# make all-gcc & make install-gcc & order of compilation: stage1, newlib, stage2
+#    Reason: everyone does in that way
+# if --enable-languages=c,c++ and only one stage
+#    1. configure: error: computing EOF failed
+#    make[3]: *** [configure-target-libstdc++-v3] Error 1
+#    2. there is no lib/gcc/riscv64-unknown-elf/9.2.0/<arch>/<abi>/crtbegin.o
+build-riscv-gcc-elf-stage1:
+	rm -rf riscv-gcc-elf-build
+	mkdir -p riscv-gcc-elf-build
+	cd riscv-gcc-elf-build && ../riscv-gcc/configure \
+        --target=riscv64-unknown-elf \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --disable-shared \
+        --disable-threads \
+        --disable-tls \
+        --enable-languages=c,c++ \
+        --with-system-zlib \
+        --with-newlib \
+        --with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+        --disable-libmudflap \
+        --disable-libssp \
+        --disable-libquadmath \
+        --disable-libgomp \
+        --disable-nls \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure-stage1.log
+	+make -C riscv-gcc-elf-build all-gcc > riscv-gcc-elf-build/build-stage1.log
+	+make -C riscv-gcc-elf-build install-gcc > riscv-gcc-elf-build/install-stage1.log
+
+# main difference from stage1: --enable-tls
+build-riscv-gcc-elf-stage2:
+	rm -rf riscv-gcc-elf-build
+	mkdir -p riscv-gcc-elf-build
+	cd riscv-gcc-elf-build && ../riscv-gcc/configure \
+        --target=riscv64-unknown-elf \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+        --disable-shared \
+        --disable-threads \
+        --enable-tls \
+        --enable-languages=c,c++ \
+        --with-system-zlib \
+        --with-newlib \
+        --with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+        --with-native-system-header-dir=/include \
+        --disable-libmudflap \
+        --disable-libssp \
+        --disable-libquadmath \
+        --disable-libgomp \
+        --disable-nls \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure-stage1.log
+	+make -C riscv-gcc-elf-build > riscv-gcc-elf-build/build-stage2.log
+	+make -C riscv-gcc-elf-build install > riscv-gcc-elf-build/install-stage2.log
+
+clean-riscv-gcc-elf:
+	rm -rf riscv-gcc-elf-build
+
+# [aefimov]: option --enable-newlib-io-long-double is removed from newlib configure due to CB-492.
+build-riscv-newlib:
+	rm -rf riscv-newlib-build
+	mkdir -p riscv-newlib-build
+	cd riscv-newlib-build && ../riscv-newlib/configure \
+        --target=riscv64-unknown-elf \
+        --prefix=$(TOOLCHAIN_PATH) \
+        --enable-newlib-io-long-long \
+        --enable-newlib-io-c99-formats \
+        CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+        CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+        > configure.log
+	+make -C riscv-newlib-build > riscv-newlib-build/build.log
+	+make -C riscv-newlib-build install > riscv-newlib-build/install.log
+
+clean-riscv-newlib:
+	rm -rf riscv-newlib-build
+
+build-riscv-gnu-toolchain-elf:
+	+make -f Makefile.elf.bear build-riscv-binutils
+	+make -f Makefile.elf.bear build-riscv-gcc-elf-stage1
+	+make -f Makefile.elf.bear build-riscv-newlib
+	+make -f Makefile.elf.bear build-riscv-gcc-elf-stage2
+
+clean-riscv-gnu-toolchain-elf: clean-riscv-binutils clean-riscv-gcc-elf clean-riscv-newlib
+
+build:
+	+make -f Makefile.elf.bear checkout-9.2
+	+make -f Makefile.elf.bear build-riscv-gnu-toolchain-elf
+#	+make -f Makefile.elf.bear checkout-8.2
+
+clean: clean-riscv-gnu-toolchain-elf
+
+build-pre-commit: build
+build-post-commit: build
+build-nightly: build
+build-weekly: build
