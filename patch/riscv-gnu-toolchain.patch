diff --git a/Makefile.bear b/Makefile.bear
new file mode 100644
index 0000000..294a334
--- /dev/null
+++ b/Makefile.bear
@@ -0,0 +1,678 @@
+##############################################################################
+#
+# @brief Rules for building riscv64-unknown-elf and riscv64-unknown-linux
+#
+# @author evgeny.linsky@cloudbear.ru
+#
+# Copyright (c) 2020 CloudBEAR LLC, all rights reserved.
+# THIS PROGRAM IS AN UNPUBLISHED WORK FULLY PROTECTED BY COPYRIGHT LAWS AND
+# IS CONSIDERED A TRADE SECRET BELONGING TO THE CLOUDBEAR LLC.
+#
+##############################################################################
+
+usage: .list-of-targets
+
+CFLAGS_FOR_TARGET :=  -mcmodel=medany
+CXXFLAGS_FOR_TARGET := -mcmodel=medany
+O_ELF = -O2
+O_LINUX = -O2
+
+# OS type the cross-compiler is build for: "linux" or "windows"
+BUILD_FOR ?= linux
+
+ifneq ($(BUILD_FOR),windows)
+# Build for Linux - no extra flags
+HOST =
+HOST_LDFLAGS =
+BINUTILS_LDFLAGS =
+else
+# Build for Windows:
+# --with-host=x86_64-w64-mingw32
+#	Compiler will be executed on Windows
+# LDFLAGS=-static
+#	Avoid problems with *.so on Windows
+# LDFLAGS=-static for binutils is not enough. See CB-1296
+#   So LDFLAGS=-all-static for binutils.
+HOST = --host=x86_64-w64-mingw32
+HOST_LDFLAGS = -static
+BINUTILS_LDFLAGS = -all-static
+endif
+
+# tag for riscv-gcc: releases/gcc-10.1.0
+# tag for newlib: newlib-3.3.0
+checkout-10.1:
+	cd riscv-binutils && git fetch origin bitmanip_2_34:bitmanip_2_34 && git checkout bitmanip_2_34
+	cd riscv-gdb && git fetch --tags && git checkout gdb-9.1-release
+	cd riscv-gcc && git fetch origin bitmanip_10.1.0:bitmanip_10.1.0 && git checkout bitmanip_10.1.0
+	cd riscv-newlib && git fetch origin branch_3.3.0:branch_3.3.0 && git checkout branch_3.3.0
+	cd riscv-glibc && git fetch origin upstream/riscv-glibc-2.26/2017ww50:upstream/riscv-glibc-2.26/2017ww50 && git checkout upstream/riscv-glibc-2.26/2017ww50
+
+# git clean required for removing prerequisites
+# (required after build for Windows, riscv-gcc is clean after build for Linux)
+checkout-8.2:
+	cd riscv-binutils && git checkout master
+	cd riscv-gdb && git checkout master
+	cd riscv-gcc && git clean -fdx && git checkout master
+	cd riscv-newlib && git checkout master
+	cd riscv-glibc && git checkout master
+
+# The building of riscv-gnu-toolchain on CentOS6 requires a newer version (devtoolset-7) of host GCC than
+# is installed by default. Consequently built toolchain will depend on newer than the default version of GCC libs.
+# We don't want such complicated setup (i.e. install new GCC) for toolchain users on CentOS6.
+# So we build toolchain with static libs, by setting LDFLAGS:=-static-libstdc++ in /etc/profile.d/static_std.sh.
+# Unfortunately, source-highlight lib (used in GDB) is incompatible with -static-libstdc++.
+# So we need to switch this lib off in configure of binutils.
+DISTRO = $(shell ( lsb_release -ds || cat /etc/*release || uname -om ) 2>/dev/null | head -n1)
+P := CentOS release 6
+ifneq (,$(findstring $(P),"$(DISTRO)"))
+	GDB_FLAGS += --disable-source-highlight
+endif
+
+# 1. gmp, isl, mpc, mpfr libs in sources (stored on /mnt) are required for building
+#	of riscv-windows-compiler.
+# 2. download_prerequisites script does not download libs again, if they exist, but
+#	it unpacks libs and sets appropriate symbol links.
+copy-riscv-gnu-toolchain-prerequisites:
+	cp -r /mnt/filer/bear/soft/riscv-gcc-prerequisites/*.tar.* riscv-gcc
+	cd riscv-gcc && contrib/download_prerequisites
+
+#
+# Newlib
+#
+
+# --datarootdir= --includedir=
+#	We have two compilers (elf, linux), so their files should copied to different directories
+#	(dir name depends on compiler)
+# For binutils:
+# --with-expat=yes
+#	Required to enable XML support used by OpenOCD
+# --disable-gdb
+# --disable-sim because when building binutils 2.34 with these options enabled, compilation fails with errors,
+#	so gdb will be built separately (riscv also uses separate build).
+# For gdb:
+# --enable-gdb
+# --disable-gas
+# --disable-binutils
+# --disable-ld
+# --disable-gold
+# --disable-gprof
+#   Disable all tools except gdb (other tools are built in binutils)
+#--disable-readline
+#	Disable library for line editing enhanced capabilities like history
+#$(GDB_FLAGS):= --disable-source-highlight (Only for CentOS6)
+#	Disable source highlighting in GDB (see detailed explanation above)
+#	On CentOS6: configure: error: source highlight is incompatible with -static-libstdc++;
+#	either use --disable-source-highlight or --without-static-standard-libraries
+#	--without-static-standard-libraries does not fix error on CentOS6
+build-riscv-binutils:
+	rm -rf riscv-binutils-build-$(HOST)
+	mkdir -p riscv-binutils-build-$(HOST)
+	cd riscv-binutils-build-$(HOST) && CC_FOR_TARGET=riscv64-unknown-elf-gcc ../riscv-binutils/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--includedir=$(TOOLCHAIN_PATH)/include/riscv64-unknown-elf \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+		--with-expat=yes \
+		--disable-gdb \
+		--disable-sim \
+		--disable-libreadline \
+		> configure.log
+ifeq ($(BINUTILS_LDFLAGS),-all-static)
+# This forces all the subdirectories to be configured immediately. A statically linked build will fail without it.
+# See CB-1296
+	+make -C riscv-binutils-build-$(HOST) configure-host > riscv-binutils-build-$(HOST)/configure-host.log
+endif
+	+make -C riscv-binutils-build-$(HOST) LDFLAGS=$(BINUTILS_LDFLAGS) > riscv-binutils-build-$(HOST)/build.log
+	+make -C riscv-binutils-build-$(HOST) install > riscv-binutils-build-$(HOST)/install.log
+
+clean-riscv-binutils:
+	rm -rf riscv-binutils-build-$(HOST)
+
+build-riscv-gdb:
+	rm -rf riscv-gdb-build-$(HOST)
+	mkdir -p riscv-gdb-build-$(HOST)
+	cd riscv-gdb-build-$(HOST) && CC_FOR_TARGET=riscv64-unknown-elf-gcc ../riscv-gdb/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--includedir=$(TOOLCHAIN_PATH)/include/riscv64-unknown-elf \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+		--enable-gdb \
+		--disable-gas \
+		--disable-binutils \
+		--disable-ld \
+		--disable-gold \
+		--disable-gprof \
+		$(GDB_FLAGS) \
+		> configure.log
+	+make -C riscv-gdb-build-$(HOST) LDFLAGS=$(HOST_LDFLAGS) > riscv-gdb-build-$(HOST)/build.log
+	+make -C riscv-gdb-build-$(HOST) install > riscv-gdb-build-$(HOST)/install.log
+
+clean-riscv-gdb:
+	rm -rf riscv-gdb-build-$(HOST)
+
+# --datarootdir=
+#   We have two compilers (elf, linux), so their files should copied to different
+#   directories (dir name depends on compiler)
+# --disable-shared
+#	Disable shared libraries
+# --disable-threads
+#	Specify that threading support should be disabled for the system.
+# --disable-tls
+#	Specify that the target does not support TLS.
+# --with-system-zlib
+#	Use installed ‘zlib’ rather than that included with GCC.
+# --with-newlib
+#	We would like to use newlib
+#	configure: error: No support for this host/target combination.
+#	make[1]: *** [configure-target-libstdc++-v3] Error 1
+# --with-sysroot=
+#	Tells GCC to consider dir as the root of a tree that contains a (subset of)
+#	the root filesystem of the target operating system. Target system headers,
+#	libraries and run-time object files will be searched in there.
+# --disable-libmudflap
+#	The mudflap run time checker was removed in GCC 4.9 and it is superseded by Address Sanitizer.
+# --disable-libssp
+#	Stack smashing protection
+#	error: unknown type name ‘size_t’
+# --disable-libquadmath
+#	128 bit math
+# --libgomp
+#	OpenMP
+#--disable-nls
+#	The --enable-nls option enables Native Language Support (NLS),
+#	which lets GCC output diagnostics in languages other than American English.
+#	Native Language Support is enabled by default if not doing a canadian cross build.
+#	The --disable-nls option disables NLS.
+#
+# make all-gcc & make install-gcc & order of compilation: stage1, newlib, stage2
+#	Reason: everyone does in that way
+# if --enable-languages=c,c++ and only one stage
+#	1. configure: error: computing EOF failed
+#	make[3]: *** [configure-target-libstdc++-v3] Error 1
+#	2. there is no lib/gcc/riscv64-unknown-elf/9.2.0/<arch>/<abi>/crtbegin.o
+build-riscv-gcc-elf-stage1:
+	rm -rf riscv-gcc-elf-build-$(HOST)
+	mkdir -p riscv-gcc-elf-build-$(HOST)
+	cd riscv-gcc-elf-build-$(HOST) && ../riscv-gcc/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+		--disable-shared \
+		--disable-threads \
+		--disable-tls \
+		--enable-languages=c,c++ \
+		--with-system-zlib \
+		--with-newlib \
+		--with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+		--disable-libmudflap \
+		--disable-libssp \
+		--disable-libquadmath \
+		--disable-libgomp \
+		--disable-nls \
+		CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+		> configure-stage1.log
+	+make -C riscv-gcc-elf-build-$(HOST) all-gcc LDFLAGS=$(HOST_LDFLAGS) > riscv-gcc-elf-build-$(HOST)/build-stage1.log
+	+make -C riscv-gcc-elf-build-$(HOST) install-gcc > riscv-gcc-elf-build-$(HOST)/install-stage1.log
+
+# main difference from stage1: --enable-tls
+build-riscv-gcc-elf-stage2:
+	rm -rf riscv-gcc-elf-build-$(HOST)
+	mkdir -p riscv-gcc-elf-build-$(HOST)
+	cd riscv-gcc-elf-build-$(HOST) && ../riscv-gcc/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-elf \
+		--disable-shared \
+		--disable-threads \
+		--enable-tls \
+		--enable-languages=c,c++ \
+		--with-system-zlib \
+		--with-newlib \
+		--with-sysroot=$(TOOLCHAIN_PATH)/riscv64-unknown-elf \
+		--with-native-system-header-dir=/include \
+		--disable-libmudflap \
+		--disable-libssp \
+		--disable-libquadmath \
+		--disable-libgomp \
+		--disable-nls \
+		CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+		> configure-stage1.log
+	+make -C riscv-gcc-elf-build-$(HOST) LDFLAGS=$(HOST_LDFLAGS) > riscv-gcc-elf-build-$(HOST)/build-stage2.log
+	+make -C riscv-gcc-elf-build-$(HOST) install > riscv-gcc-elf-build-$(HOST)/install-stage2.log
+
+clean-riscv-gcc-elf:
+	rm -rf riscv-gcc-elf-build-$(HOST)
+
+# Temporary dir to install newlib nano version to
+NEWLIB_NANO_PREFIX = $(shell pwd)/riscv-newlib-nano-install
+
+# [aefimov]: option --enable-newlib-io-long-double is removed from newlib configure due to CB-492.
+build-riscv-newlib:
+	rm -rf riscv-newlib-build-$(HOST)
+	mkdir -p riscv-newlib-build-$(HOST)
+	cd riscv-newlib-build-$(HOST) && ../riscv-newlib/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--enable-newlib-io-long-long \
+		--enable-newlib-io-c99-formats \
+		CFLAGS_FOR_TARGET="$(O_ELF) $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="$(O_ELF) $(CXXFLAGS_FOR_TARGET)" \
+		> configure.log
+	+make -C riscv-newlib-build-$(HOST) > riscv-newlib-build-$(HOST)/build.log
+	+make -C riscv-newlib-build-$(HOST) install > riscv-newlib-build-$(HOST)/install.log
+
+build-riscv-newlib-nano:
+	rm -rf riscv-newlib-nano-build-$(HOST) $(NEWLIB_NANO_PREFIX)-$(HOST)
+	mkdir riscv-newlib-nano-build-$(HOST)
+	cd riscv-newlib-nano-build-$(HOST) && ../riscv-newlib/configure \
+		--target=riscv64-unknown-elf \
+		$(HOST) \
+		--prefix=$(NEWLIB_NANO_PREFIX)-$(HOST) \
+		--enable-newlib-reent-small \
+		--disable-newlib-fvwrite-in-streamio \
+		--disable-newlib-fseek-optimization \
+		--disable-newlib-wide-orient \
+		--enable-newlib-nano-malloc \
+		--disable-newlib-unbuf-stream-opt \
+		--enable-lite-exit \
+		--enable-newlib-global-atexit \
+		--enable-newlib-nano-formatted-io \
+		--disable-newlib-supplied-syscalls \
+		--disable-nls \
+		--enable-newlib-register-fini \
+		CFLAGS_FOR_TARGET="-Os -ffunction-sections -fdata-sections $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="-Os -ffunction-sections -fdata-sections $(CXXFLAGS_FOR_TARGET)"
+	+make -C riscv-newlib-nano-build-$(HOST) > riscv-newlib-nano-build-$(HOST)/build.log
+	+make -C riscv-newlib-nano-build-$(HOST) install > riscv-newlib-nano-build-$(HOST)/install.log
+
+merge-riscv-newlib-nano:
+# Copy nano library files into newlib install dir.
+	set -e; \
+		for ml in `$(TOOLCHAIN_PATH)/bin/riscv64-unknown-elf-gcc --print-multi-lib`; \
+	do \
+		mld=`echo $${ml} | sed -e 's/;.*$$//'`; \
+		cp $(NEWLIB_NANO_PREFIX)-$(HOST)/riscv64-unknown-elf/lib/$${mld}/libc.a \
+		$(TOOLCHAIN_PATH)/riscv64-unknown-elf/lib/$${mld}/libc_nano.a; \
+		cp $(NEWLIB_NANO_PREFIX)-$(HOST)/riscv64-unknown-elf/lib/$${mld}/libg.a \
+		$(TOOLCHAIN_PATH)/riscv64-unknown-elf/lib/$${mld}/libg_nano.a; \
+		cp $(NEWLIB_NANO_PREFIX)-$(HOST)/riscv64-unknown-elf/lib/$${mld}/libgloss.a\
+		$(TOOLCHAIN_PATH)/riscv64-unknown-elf/lib/$${mld}/libgloss_nano.a; \
+	done
+# Copy nano header files into newlib install dir.
+	mkdir -p $(TOOLCHAIN_PATH)/riscv64-unknown-elf/include/newlib-nano; \
+	cp $(NEWLIB_NANO_PREFIX)-$(HOST)/riscv64-unknown-elf/include/newlib.h \
+		$(TOOLCHAIN_PATH)/riscv64-unknown-elf/include/newlib-nano/newlib.h; \
+
+clean-riscv-newlib:
+	rm -rf riscv-newlib-build-$(HOST) riscv-newlib-nano-build-$(HOST) $(NEWLIB_NANO_PREFIX)-$(HOST)
+
+# check if Linux of riscv64-unknown-elf-gcc exists in path.
+# NO_GCC_ELF_LINUX ?= $(shell which riscv64-unknown-elf-gcc >/dev/null>/dev/null 2>/dev/null; echo $$?)
+
+# for the first time let's guarantee usage of GCC 9.2 Linux for GCC 9.2 Windows
+NO_GCC_ELF_LINUX := 1
+
+# riscv-linux-compiler (local or from /opt) is required for building libs (libc etc), because already built
+# riscv-windows-compiler could not be executed for this purpose in Linux.
+build-riscv-gnu-toolchain-elf:
+ifeq ($(BUILD_FOR),windows)
+ifeq ($(NO_GCC_ELF_LINUX),1)
+	+make -f Makefile.bear build-riscv-gnu-toolchain-elf BUILD_FOR=linux
+endif
+	+make -f Makefile.bear copy-riscv-gnu-toolchain-prerequisites
+endif
+	+make -f Makefile.bear build-riscv-binutils build-riscv-gdb
+	+make -f Makefile.bear build-riscv-gcc-elf-stage1
+	+make -f Makefile.bear build-riscv-newlib build-riscv-newlib-nano
+	+make -f Makefile.bear merge-riscv-newlib-nano
+	+make -f Makefile.bear build-riscv-gcc-elf-stage2
+
+clean-riscv-gnu-toolchain-elf: \
+	clean-riscv-binutils clean-riscv-gdb clean-riscv-gcc-elf clean-riscv-newlib
+
+build-riscv-gnu-toolchain-elf-win:
+	+make -f Makefile.bear build-riscv-gnu-toolchain-elf BUILD_FOR=windows
+
+clean-riscv-gnu-toolchain-elf-win:
+	+make -f Makefile.bear clean-riscv-gnu-toolchain-elf BUILD_FOR=windows
+
+#
+# glibc
+#
+
+build-riscv-linux-headers:
+	mkdir -p $(TOOLCHAIN_PATH)/sysroot/usr/
+	cp -a linux-headers/include $(TOOLCHAIN_PATH)/sysroot/usr/
+
+clean-riscv-linux-headers:
+	rm -rf $(TOOLCHAIN_PATH)/sysroot/usr/
+
+# --datarootdir= --includedir=
+#	We have two compilers (elf, linux), so their files should copied to different
+#	directories (dir name depends on compiler)
+# For binutils:
+# --with-expat=yes
+#	Required to enable XML support used by OpenOCD
+# --disable-gdb
+# --disable-sim because when building binutils 2.34 with these options enabled, compilation fails with errors,
+#	so gdb will be built separately (riscv also uses separate build).
+# For gdb:
+# --enable-gdb
+# --disable-gas
+# --disable-binutils
+# --disable-ld
+# --disable-gold
+# --disable-gprof
+#   Disable all tools except gdb (other tools are built in binutils)
+# --disable-readline
+#	Disable library for line editing enhanced capabilities like history
+# --disable-libdecnumber
+#	Disable library for decimal arithmetics
+#$(GDB_FLAGS):= --disable-source-highlight (Only for CentOS6)
+#	Disable source highlighting in GDB (see detailed explanation above)
+#	On CentOS6: configure: error: source highlight is incompatible with -static-libstdc++;
+#	either use --disable-source-highlight or --without-static-standard-libraries
+#	--without-static-standard-libraries does not fix error on CentOS6
+# --disable-werror
+#	Disable treating warnings as errors
+# --disable-nls
+#	Disable native language support (diagnostic message in languages other than english)
+# --with-sysroot=
+#	the root of a tree that contains a (subset of) the root filesystem of the target operating system.
+#	Target system headers, libraries and run-time object files will be searched in there.
+# CC_FOR_TARGET is required for the ld testsuite.
+build-riscv-binutils-linux:
+	rm -rf riscv-binutils-linux-build
+	mkdir -p riscv-binutils-linux-build
+	cd riscv-binutils-linux-build && CC_FOR_TARGET=riscv64-unknown-linux-gnu-gcc ../riscv-binutils/configure \
+		--target=riscv64-unknown-linux-gnu \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-linux \
+		--with-sysroot=$(TOOLCHAIN_PATH)/sysroot \
+		--enable-multilib \
+		--disable-werror \
+		--disable-nls \
+		--with-expat=yes \
+		--disable-gdb \
+		--disable-sim \
+		--disable-libdecnumber \
+		--disable-libreadline > configure.log
+	+make -C riscv-binutils-linux-build > riscv-binutils-linux-build/build.log
+	+make -C riscv-binutils-linux-build install > riscv-binutils-linux-build/install.log
+
+clean-riscv-binutils-linux:
+	rm -rf riscv-binutils-linux-build
+
+build-riscv-gdb-linux:
+	rm -rf riscv-gdb-linux-build
+	mkdir riscv-gdb-linux-build
+	cd riscv-gdb-linux-build && CC_FOR_TARGET=riscv64-unknown-linux-gnu-gcc ../riscv-gdb/configure \
+		--target=riscv64-unknown-linux-gnu \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--includedir=$(TOOLCHAIN_PATH)/include/riscv64-unknown-linux \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-linux \
+		--with-sysroot=$(TOOLCHAIN_PATH)/sysroot \
+		--enable-multilib \
+		--disable-werror \
+		--disable-nls \
+		--with-expat=yes \
+		--enable-gdb \
+		--disable-gas \
+		--disable-binutils \
+		--disable-ld \
+		--disable-gold \
+		--disable-gprof \
+		$(GDB_FLAGS) \
+		> configure.log
+	+make -C riscv-gdb-linux-build > riscv-gdb-linux-build/build.log
+	+make -C riscv-gdb-linux-build install > riscv-gdb-linux-build/install.log
+
+clean-riscv-gdb-linux:
+	rm -rf riscv-gdb-linux-build
+
+# --disable-multilib
+#	Headers are the same for all versions of glibc libraries
+# For glibc-linux-headers, glibc-linux-%:
+# --enable-shared
+#	Build shared version of libraries
+# --enable-kernel=
+#	The smallest version of the Linux kernel the generated library is expected to support
+# --with-headers=
+#	The GNU C Library needs information from the kernel’s header files describing the interface to the kernel.
+#	On, reason: for not having any dependencies on kernel version of the host, where riscv-gcc is compiled.
+build-riscv-glibc-linux-headers:
+	rm -rf riscv-glibc-linux-headers-build
+	mkdir -p riscv-glibc-linux-headers-build
+	cd riscv-glibc-linux-headers-build && CC="riscv64-unknown-linux-gnu-gcc" ../riscv-glibc/configure \
+		--host=riscv64-unknown-linux-gnu \
+		--prefix=$(TOOLCHAIN_PATH)/sysroot/usr \
+		--enable-shared \
+		--with-headers=$(BEAR)/riscv-gnu-toolchain/linux-headers/include \
+		--disable-multilib \
+		--enable-kernel=3.0.0 > configure.log
+	+make -C riscv-glibc-linux-headers-build install-headers > riscv-glibc-linux-headers-build/install.log
+
+clean-riscv-glibc-linux-headers:
+	rm -rf riscv-glibc-linux-headers-build
+
+# --disable-werror
+#	Disable treating warnings as errors
+# --enable-obsolete-rpc
+#	glibc will be generated with obsolete headers (like rpc.h), because some softwate still uses it
+build-riscv-glibc-linux-%:
+	$(eval $@_ARCH := $(word 5,$(subst -, ,$@)))
+	$(eval $@_ABI := $(word 6,$(subst -, ,$@)))
+	$(eval $@_LIBDIRSUFFIX := $(if $($@_ABI),$(shell echo $($@_ARCH) | sed 's/.*rv\([0-9]*\).*/\1/')/$($@_ABI),))
+	$(eval $@_XLEN := $(if $($@_ABI),$(shell echo $($@_ARCH) | sed 's/.*rv\([0-9]*\).*/\1/'),$(XLEN)))
+	$(eval $@_CFLAGS := $(if $($@_ABI),-march=$($@_ARCH) -mabi=$($@_ABI),))
+	$(eval $@_LIBDIROPTS := $(if $@_LIBDIRSUFFIX,--libdir=/usr/lib$($@_LIBDIRSUFFIX) libc_cv_slibdir=/lib$($@_LIBDIRSUFFIX) libc_cv_rtlddir=/lib,))
+	rm -rf riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build
+	mkdir riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build
+	cd riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build && \
+		CC="riscv64-unknown-linux-gnu-gcc $($@_CFLAGS)" \
+		CXX="$(GLIBC_CXX_FOR_TARGET) $($@_CFLAGS)" \
+		CFLAGS="$(CFLAGS_FOR_TARGET) -g $(O_LINUX) $($@_CFLAGS)" \
+		CXXFLAGS="$(CXXFLAGS_FOR_TARGET) -g $(O_LINUX) $($@_CFLAGS)" \
+		ASFLAGS="$(ASFLAGS_FOR_TARGET) $($@_CFLAGS)" \
+		../riscv-glibc/configure \
+		--host=riscv$($@_XLEN)-unknown-linux-gnu \
+		--prefix=/usr \
+		--disable-werror \
+		--enable-shared \
+		--enable-obsolete-rpc \
+		--with-headers=$(BEAR)/riscv-gnu-toolchain/linux-headers/include \
+		--enable-multilib \
+		--enable-kernel=3.0.0 \
+		$($@_LIBDIROPTS) > configure.log
+	+make -C riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build > riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build/build.log
+	+flock $(TOOLCHAIN_PATH)/sysroot/.lock make -C riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build install \
+		install_root=$(TOOLCHAIN_PATH)/sysroot > riscv-glibc-linux-$($@_ARCH)-$($@_ABI)-build/install.log
+
+build-riscv-glibc-linux: build-riscv-glibc-linux-rv64imafdc-lp64d build-riscv-glibc-linux-rv32imafc-ilp32f
+
+clean-riscv-glibc-linux:
+	rm -rf riscv-glibc-linux-*-build
+
+# Specific for stage1. Stage1: compile target gcc by host gcc.
+# --disable-shared
+#	Disable shared libraries
+# --disable-threads
+#	Specify that threading support should be disabled
+# --with-newlib
+# --without-headers
+# --enable-language=c
+
+# For both stages:
+# --enable-tls
+#	Specify that the target  supports TLS.
+# --datarootdir=
+#	We have two compilers (elf, linux), so their files should copied to different
+#	directories (dir name depends on compiler)
+# --with-system-zlib
+#	Use installed ‘zlib’ rather than that included with GCC.
+# --with-sysroot=
+#	Tells GCC to consider dir as the root of a tree that contains a (subset of)
+#	the root filesystem of the target operating system. Target system headers,
+#	libraries and run-time object files will be searched in there.
+# --disable-libatomic
+# --disable-libmudflap // mudflap runtime checker
+# --disable-libssp // stack smashing protection
+# --disable-libquadmath // 128 bit math
+# --disable-libgomp // OpenMP
+#  	These switches disable support for libatomic, libgomp, libmudflap, libquadmath, libssp respectively.
+#  	These features will fail to compile when building a cross-compiler and are not necessary
+#  	for the task of cross-compiling.
+#--disable-nls
+#	The --enable-nls option enables Native Language Support (NLS),
+#	which lets GCC output diagnostics in languages other than American English.
+#	Native Language Support is enabled by default if not doing a canadian cross build.
+#	The --disable-nls option disables NLS.
+#--disable-bootstrap
+#	Perform only one stage (not all stages at once)
+build-riscv-gcc-linux-stage1:
+	rm -rf riscv-gcc-linux-stage1-build
+	mkdir riscv-gcc-linux-stage1-build
+	cd riscv-gcc-linux-stage1-build && ../riscv-gcc/configure \
+		--target=riscv64-unknown-linux-gnu \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-linux \
+		--with-sysroot=$(TOOLCHAIN_PATH)/sysroot \
+		--with-newlib \
+		--without-headers \
+		--disable-shared \
+		--disable-threads \
+		--with-system-zlib \
+		--enable-tls \
+		--enable-languages=c \
+		--disable-libatomic \
+		--disable-libmudflap \
+		--disable-libssp \
+		--disable-libquadmath \
+		--disable-libgomp \
+		--disable-nls \
+		--disable-bootstrap \
+		--enable-multilib \
+		--with-abi=lp64d \
+		--with-arch=rv64imafdc \
+		CFLAGS_FOR_TARGET="$(O_LINUX) $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="$(O_LINUX) $(CXXFLAGS_FOR_TARGET)" > configure.log
+	+make -C riscv-gcc-linux-stage1-build inhibit-libc=true all-gcc > riscv-gcc-linux-stage1-build/build.log
+	+make -C riscv-gcc-linux-stage1-build inhibit-libc=true install-gcc > riscv-gcc-linux-stage1-build/install.log
+	+make -C riscv-gcc-linux-stage1-build inhibit-libc=true all-target-libgcc >> riscv-gcc-linux-stage1-build/build.log
+	+make -C riscv-gcc-linux-stage1-build inhibit-libc=true install-target-libgcc >> riscv-gcc-linux-stage1-build/install.log
+
+clean-riscv-gcc-linux-stage1:
+	rm -rf riscv-gcc-linux-stage1-build
+
+# Specific for stage2. Stage2: compile target gcc by target gcc.
+# --disable-libsanitizer
+#	libsanitizer not supported rv32, but it will break the rv64 multi-lib build,
+#	so we disable that temporally untill rv32 supported.
+# --enable-language=c,c++,fortran
+# --enable-shared
+#	Enable shared libraries
+build-riscv-gcc-linux-stage2:
+	rm -rf riscv-gcc-linux-stage2-build
+	mkdir riscv-gcc-linux-stage2-build
+	cd riscv-gcc-linux-stage2-build && ../riscv-gcc/configure \
+		--target=riscv64-unknown-linux-gnu \
+		--prefix=$(TOOLCHAIN_PATH) \
+		--datarootdir=$(TOOLCHAIN_PATH)/share/riscv64-unknown-linux \
+		--with-sysroot=$(TOOLCHAIN_PATH)/sysroot \
+		--with-system-zlib \
+		--enable-shared \
+		--enable-tls \
+		--enable-languages=c,c++,fortran \
+		--disable-libmudflap \
+		--disable-libssp \
+		--disable-libquadmath \
+		--disable-libsanitizer \
+		--disable-nls \
+		--disable-bootstrap \
+		--enable-multilib \
+		--with-abi=lp64d \
+		--with-arch=rv64imafdc \
+		CFLAGS_FOR_TARGET="$(O_LINUX) $(CFLAGS_FOR_TARGET)" \
+		CXXFLAGS_FOR_TARGET="$(O_LINUX) $(CXXFLAGS_FOR_TARGET)" > configure.log
+	+make -C riscv-gcc-linux-stage2-build > riscv-gcc-linux-stage2-build/build.log
+	+make -C riscv-gcc-linux-stage2-build install > riscv-gcc-linux-stage2-build/install.log
+	cp -a $(TOOLCHAIN_PATH)/riscv64-unknown-linux-gnu/lib* $(TOOLCHAIN_PATH)/sysroot
+
+clean-riscv-gcc-linux-stage2:
+	rm -rf riscv-gcc-linux-stage2-build
+
+build-riscv-gnu-toolchain-linux:
+	+make -f Makefile.bear copy-riscv-gnu-toolchain-prerequisites
+	+make -f Makefile.bear build-riscv-binutils-linux build-riscv-gdb-linux
+	+make -f Makefile.bear build-riscv-linux-headers
+	+make -f Makefile.bear build-riscv-gcc-linux-stage1
+	+make -f Makefile.bear build-riscv-glibc-linux-headers
+	+make -f Makefile.bear build-riscv-glibc-linux
+	+make -f Makefile.bear build-riscv-gcc-linux-stage2
+
+clean-riscv-gnu-toolchain-linux: \
+	clean-riscv-binutils-linux clean-riscv-gdb-linux clean-riscv-linux-headers \
+	clean-riscv-gcc-linux-stage1 \
+	clean-riscv-glibc-linux-headers clean-riscv-glibc-linux \
+	clean-riscv-gcc-linux-stage2
+
+#
+# General targets
+#
+
+build-elf:
+	+make -f Makefile.bear checkout-10.1
+	+make -f Makefile.bear build-riscv-gnu-toolchain-elf
+	+make -f Makefile.bear checkout-8.2
+
+clean-elf: clean-riscv-gnu-toolchain-elf
+
+build-pre-commit-elf: build-elf
+build-post-commit-elf: build-elf
+build-nightly-elf: build-elf
+build-weekly-elf: build-elf
+
+build-elf-win:
+	+make -f Makefile.bear checkout-10.1
+	+make -f Makefile.bear build-riscv-gnu-toolchain-elf-win
+	+make -f Makefile.bear checkout-8.2
+
+clean-elf-win: clean-riscv-gnu-toolchain-elf-win
+
+build-pre-commit-elf-win: build-elf-win
+build-post-commit-elf-win: build-elf-win
+build-nightly-elf-win: build-elf-win
+build-weekly-elf-win: build-elf-win
+
+build-linux:
+	+make -f Makefile.bear checkout-10.1
+	+make -f Makefile.bear build-riscv-gnu-toolchain-linux
+	+make -f Makefile.bear checkout-8.2
+
+clean-linux: clean-riscv-gnu-toolchain-linux
+
+build-pre-commit-linux: build-linux
+build-post-commit-linux: build-linux
+build-nightly-linux: build-linux
+build-weekly-linux: build-linux
+
+build: build-linux build-elf build-elf-win
+
+clean: clean-linux clean-elf clean-elf-win
+
+.list-of-targets:
+	@echo "Usage:"
+	@echo "  make [-j<N>] [<target> [...]]"
+	@echo
+	@echo "Build targets:"
+	@echo "  build-elf/clean-elf: build/clean elf toolchain"
+	@echo "  build-elf-win/clean-elf-win: build/clean elf toolchain for Windows"
+	@echo "  build-linux/clean-liux: build/clean linux toolchain"
+	@echo "  build/clean: build/clean all"
