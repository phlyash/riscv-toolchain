From ca915f6e939f401027872b5846a3435b8c033388 Mon Sep 17 00:00:00 2001
From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Mon, 10 Mar 2025 15:04:14 +0300
Subject: Fix operands for SFB CRC peephole

Issue: CB-4832
Change-Id: Id0c724a9177170941a7546bd07a0c5238a410a0d
---
 gcc/config/riscv/cloudbear.md | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/gcc/config/riscv/cloudbear.md b/gcc/config/riscv/cloudbear.md
index 036c6cf46fb..e21b2eb2fac 100644
--- a/gcc/config/riscv/cloudbear.md
+++ b/gcc/config/riscv/cloudbear.md
@@ -29,7 +29,7 @@
 ;; Main CRC pattern for SFB
 (define_peephole2
   [
-   (match_scratch:X 5 "r")
+   (match_scratch:X 4 "r")
    (set (match_operand:X 0 "register_operand")
 	(if_then_else:X	  (ne
 			    (match_operand:X 1 "register_operand")
@@ -37,18 +37,18 @@
 			  (match_dup 0)
 			  (const_int 0)))
    (set (match_dup 0)
-	(xor:X (match_dup 0) (match_operand:X 3 "register_operand")))
-   (match_dup 5)
-   (set (match_dup 0) (zero_extend:X (match_operand:HI 4 "register_operand")))]
+	(xor:X (match_dup 0) (match_operand:X 2 "register_operand")))
+   (match_dup 4)
+   (set (match_dup 0) (zero_extend:X (match_operand:HI 3 "register_operand")))]
   "TARGET_SFB_ALU && TARGET_ZBB
-   && REGNO (operands[0]) == REGNO (operands[4])
-   && check_reg_holds_hi_value (peep2_next_insn(0), operands[3])"
+   && REGNO (operands[0]) == REGNO (operands[3])
+   && check_reg_holds_hi_value (peep2_next_insn(0), operands[2])"
   [
-   (set (match_dup 5) (zero_extend:X (subreg:HI (match_dup 2) 0)))
-   (set (match_dup 5) (if_then_else:X (ne (match_dup 1) (const_int 0))
-				      (match_dup 5)
+   (set (match_dup 4) (zero_extend:X (subreg:HI (match_dup 0) 0)))
+   (set (match_dup 4) (if_then_else:X (ne (match_dup 1) (const_int 0))
+				      (match_dup 4)
 				      (const_int 0)))
-   (set (match_dup 0) (unspec [(xor:X (match_dup 5) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
+   (set (match_dup 0) (unspec [(xor:X (match_dup 4) (match_dup 2))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
 
 
 ;; Second CRC variant (used for current draft of bxx72 mtune, so 64-bit variant only)
-- 
2.39.3


