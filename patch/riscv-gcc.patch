From 742625b498bf89600090f5c168014214e3d8ea3a Mon Sep 17 00:00:00 2001
From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Wed, 5 Mar 2025 02:19:16 +0300
Subject: Use sfb if zicond is not enabled

Issue: CB-4832
Change-Id: Ib388538c5d671a22ed6ced1a3d99e9105c8ad076
---
 gcc/config/riscv/cloudbear.md | 16 +++++++++-------
 gcc/config/riscv/riscv.h      | 14 +++++++++++---
 2 files changed, 20 insertions(+), 10 deletions(-)

diff --git a/gcc/config/riscv/cloudbear.md b/gcc/config/riscv/cloudbear.md
index 9e8ca087067..d76edffb705 100644
--- a/gcc/config/riscv/cloudbear.md
+++ b/gcc/config/riscv/cloudbear.md
@@ -1,14 +1,16 @@
 ;; TODO: replace or with any_bitwize, mb generalize shift instruction?
-
-;; First CRC variant
 ;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
+
+;; Main CRC pattern for zicond
 (define_peephole2
   [
    (match_scratch:X 5 "r")
    (set (match_operand:X 0 "register_operand")
-	(if_then_else:X (eq:X (match_operand:X 1 "register_operand") (const_int 0))
-			 (const_int 0)
-			 (match_operand:X 2 "register_operand")))
+	(if_then_else:X	  (eq
+			    (match_operand:X 1 "register_operand")
+			    (const_int 0))
+			  (const_int 0)
+			  (match_operand:X 2 "register_operand")))
    (set (match_dup 0)
 	(xor:X (match_dup 0) (match_operand:X 3 "register_operand")))
    (match_dup 5)
@@ -19,8 +21,8 @@
   [
    (set (match_dup 5) (zero_extend:X (subreg:HI (match_dup 2) 0)))
    (set (match_dup 0) (if_then_else:X (eq:X (match_dup 1) (const_int 0))
-				       (match_dup 5)
-				       (const_int 0)))
+				      (const_int 0)
+				      (match_dup 5)))
    (set (match_dup 0) (unspec [(xor:X (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
 
 ;; Second CRC variant (used for current draft of bxx72 mtune, so 64-bit variant only)
diff --git a/gcc/config/riscv/riscv.h b/gcc/config/riscv/riscv.h
index d872525df1d..2c75a137a75 100644
--- a/gcc/config/riscv/riscv.h
+++ b/gcc/config/riscv/riscv.h
@@ -914,9 +914,17 @@ extern enum riscv_cc get_riscv_cc (const rtx use);
    counterparts, including C.MV and C.LI) can be in the branch shadow.  */
 
 #define TARGET_SFB_ALU \
- ((riscv_microarchitecture == sifive_7) \
-  || (riscv_microarchitecture == sifive_p400) \
-  || (riscv_microarchitecture == sifive_p600))
+  (!TARGET_ZICOND \
+   && ((riscv_microarchitecture == sifive_7) \
+      || (riscv_microarchitecture == sifive_p400) \
+      || (riscv_microarchitecture == sifive_p600) \
+      || (riscv_microarchitecture == bxx52) \
+      || (riscv_microarchitecture == bxx72)))
+
+#define TARGET_PREFER_ZICOND_OVER_SFB \
+  (TARGET_ZICOND \
+   && (riscv_microarchitecture == bxx52 \
+       || riscv_microarchitecture == bxx72))
 
 #define LOGICAL_OP_NON_SHORT_CIRCUIT 0
 
-- 
