From c33135ab7ac5668bc186de8c000d5c719e19e645 Mon Sep 17 00:00:00 2001
From: Dmitry Ryzhov <dmitry.ryzhov@cloudbear.ru>
Date: Thu, 5 Nov 2020 14:23:45 +0300
Subject: =?UTF-8?q?Reworked=20checkout=20submodules=20mechanism=20on=20com?=
 =?UTF-8?q?piler=20building.=0AIf=20submodule=20at=20master,=20then=20it?=
 =?UTF-8?q?=20will=20be=20checkouted=20to=20a=20version=20branch,=20otherw?=
 =?UTF-8?q?ise=20a=20current=20branch=20(selected=20by=20user=20earlier)?=
 =?UTF-8?q?=20will=20be=20kept.?=

Change-Id: Ib4fc76b2ebd82ecdae3473fe39975cd3e7affad5
---
 Makefile.bear | 43 +++++++++++++++++++++++++++++++------------
 1 file changed, 31 insertions(+), 12 deletions(-)

diff --git a/Makefile.bear b/Makefile.bear
index b81314e..75d81c0 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -47,18 +47,37 @@ HOST_LDFLAGS = -static
 BINUTILS_LDFLAGS = -all-static
 endif
 
-# tag for riscv-gcc: releases/gcc-10.2.0
-# tag for newlib: newlib-3.3.0
-checkout-10.2:
-	cd riscv-binutils && git fetch origin bitmanip_2_34:bitmanip_2_34 && git checkout bitmanip_2_34
-	cd riscv-gdb && git fetch --tags && git checkout gdb-9.1-release
-	cd riscv-gcc && git fetch origin bitmanip_10.2.0:bitmanip_10.2.0 && git checkout bitmanip_10.2.0
-	cd riscv-newlib && git fetch origin branch_3.3.0:branch_3.3.0 && git checkout branch_3.3.0
-	cd riscv-glibc && git fetch origin 2.33dev-ilp32f:2.33dev-ilp32f && git checkout 2.33dev-ilp32f
+# Simple function for getting i-th word from '_'-separated string.
+get-word = $(word $2,$(subst _, ,$1))
+
+# Template should be called like "checkout-submodule-<name>_<version>", e.g. "checkout-submodule-riscv-gcc_10.2"
+# Checkout version branch if now it at master, otherwise keep current branch.
+# 	grep: -w = exact match.
+checkout-submodule-%:
+	cd $(call get-word, $*, 1) && \
+        if git rev-parse --abbrev-ref HEAD | grep -w master; \
+        then \
+            echo "$(call get-word, $*, 1) in master, so checkouting $(call get-word, $*, 2)."; \
+            git fetch origin $(call get-word, $*, 2):$(call get-word, $*, 2) && git checkout $(call get-word, $*, 2); \
+        else \
+            echo "$(call get-word, $*, 1) NOT in master, so holding current branch."; \
+        fi;
+
+checkout-10.2: checkout-submodule-riscv-binutils_10.2 \
+               checkout-submodule-riscv-gdb_10.2 \
+               checkout-submodule-riscv-gcc_10.2 \
+               checkout-submodule-riscv-newlib_10.2 \
+               checkout-submodule-riscv-glibc_10.2
+
+checkout-8.2:  checkout-submodule-riscv-binutils_8.2 \
+               checkout-submodule-riscv-gdb_8.2 \
+               checkout-submodule-riscv-gcc_8.2 \
+               checkout-submodule-riscv-newlib_8.2 \
+               checkout-submodule-riscv-glibc_8.2
 
 # git clean required for removing prerequisites
 # (required after build for Windows, riscv-gcc is clean after build for Linux)
-checkout-8.2:
+checkout-master:
 	cd riscv-binutils && git checkout master
 	cd riscv-gdb && git checkout master
 	cd riscv-gcc && git clean -fdx && git checkout master
@@ -642,7 +661,7 @@ clean-riscv-gnu-toolchain-linux: \
 build-elf:
 	+make -f Makefile.bear checkout-10.2
 	+make -f Makefile.bear build-riscv-gnu-toolchain-elf
-	+make -f Makefile.bear checkout-8.2
+	+make -f Makefile.bear checkout-master
 
 clean-elf: clean-riscv-gnu-toolchain-elf
 
@@ -654,7 +673,7 @@ build-weekly-elf: build-elf
 build-elf-win:
 	+make -f Makefile.bear checkout-10.2
 	+make -f Makefile.bear build-riscv-gnu-toolchain-elf-win
-	+make -f Makefile.bear checkout-8.2
+	+make -f Makefile.bear checkout-master
 
 clean-elf-win: clean-riscv-gnu-toolchain-elf-win
 
@@ -666,7 +685,7 @@ build-weekly-elf-win: build-elf-win
 build-linux:
 	+make -f Makefile.bear checkout-10.2
 	+make -f Makefile.bear build-riscv-gnu-toolchain-linux
-	+make -f Makefile.bear checkout-8.2
