From c97ed77b51a72851138371f1536818d68a1f99a2 Mon Sep 17 00:00:00 2001
From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Wed, 15 Jan 2025 15:56:02 +0300
Subject: fixup! adapt division cost by second operand

* Revert new division schema for all mtunes except for bxx51, bxx52
* Simplify estimation function

Change-Id: Ibe4967c0c54a94407298adca48d46daa931143d0
---
 gcc/config/riscv/riscv.cc | 28 ++++++++++++----------------
 1 file changed, 12 insertions(+), 16 deletions(-)

diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index e93787a1003..e28a596908a 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -453,7 +453,9 @@ static const struct riscv_tune_param bxx72_tune_info = {
   {COSTS_N_INSNS (4),  COSTS_N_INSNS (5)},	/* fp_mul */
   {COSTS_N_INSNS (20), COSTS_N_INSNS (20)},	/* fp_div */
   {COSTS_N_INSNS (4),  COSTS_N_INSNS (4)},	/* int_mul */
-  {COSTS_N_INSNS (16), COSTS_N_INSNS (32)},	/* int_div */
+  /* Following div cost guarantee emit div/rem insn instead of barrett reduction.
+     We believe that it's profitable for OoO */
+  {COSTS_N_INSNS (6), COSTS_N_INSNS (6)},	/* int_div */
   1,						/* issue_rate */
   5,						/* branch_cost */
   5,						/* memory_cost */
@@ -3223,19 +3225,11 @@ riscv_extend_cost (rtx op, bool unsigned_p)
 }
 
 static int
-cloudbear_div_cost (machine_mode mode, HOST_WIDE_INT divisor) {
-  int target_wide;
+cloudbear_div_by_const_cost (machine_mode mode, HOST_WIDE_INT divisor) {
   divisor = (divisor < 0) ? -divisor : divisor;
-  if (mode == DImode) {
-    target_wide = 64;
-  } else if (mode == SImode) {
-    target_wide = 32;
-  } else if (mode == HImode) {
-    target_wide = 16;
-  } else {
-    target_wide = sizeof(HOST_WIDE_INT);
-  }
-  return MAX ((sizeof(HOST_WIDE_INT) - target_wide + clz_hwi (divisor)) / 2, 3);
+  int mode_sz = GET_MODE_BITSIZE (mode).coeffs[0];
+  int clz_target = mode_sz - (64 - clz_hwi (divisor));
+  return MAX (clz_target / 2, 3);
 }
 
 /* Implement TARGET_RTX_COSTS.  */
@@ -3686,8 +3680,10 @@ riscv_rtx_costs (rtx x, machine_mode mode, int outer_code, int opno ATTRIBUTE_UN
 	/* Estimate the cost of a library call.  */
 	*total = COSTS_N_INSNS (speed ? 32 : 6);
       else if (speed) {
-	if (CONST_INT_P (XEXP (x, 1))) {
-	  *total = COSTS_N_INSNS (cloudbear_div_cost (mode, INTVAL (XEXP (x, 1))));
+	if (CONST_INT_P (XEXP (x, 1))
+	    && (GET_MODE_CLASS (mode) == MODE_INT)
+	    && (riscv_microarchitecture == bxx51 || riscv_microarchitecture == bxx52)) {
+	  *total = COSTS_N_INSNS (cloudbear_div_by_const_cost (mode, INTVAL (XEXP (x, 1))));
 	} else
 	  *total = tune_param->int_div[mode == DImode];
       } else
@@ -8529,7 +8525,7 @@ riscv_load_to_agu_bypass_p (rtx_insn *out_insn, rtx_insn *in_insn)
 
   machine_mode mode = GET_MODE (SET_DEST (out_set));
   if (!REG_P (SET_DEST (out_set))
-      || !(mode == DImode && TARGET_64BIT || mode == SImode && !TARGET_64BIT))
+      || !((mode == DImode && TARGET_64BIT) || (mode == SImode && !TARGET_64BIT)))
     return false;
 
   if (REG_P (SET_DEST (in_set))) {
