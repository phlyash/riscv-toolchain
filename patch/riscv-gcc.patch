From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Wed, 6 Sep 2023 18:53:37 +0300
Subject: First implementation of mtune for bxx51 and bxx52.

Issue: CB-3376
Change-Id: Ib4f7c72aec5b4f8a0fbc5a68ee52d4132a6a2fdf
---
 gcc/config/riscv/bxx51.md        | 143 +++++++++++++++++++++++++++
 gcc/config/riscv/bxx52.md        | 161 +++++++++++++++++++++++++++++++
 gcc/config/riscv/riscv-cores.def |   5 +
 gcc/config/riscv/riscv-opts.h    |   2 +
 gcc/config/riscv/riscv-protos.h  |   1 +
 gcc/config/riscv/riscv.cc        |  88 +++++++++++++++++
 gcc/config/riscv/riscv.h         |   3 +-
 gcc/config/riscv/riscv.md        |   4 +-
 8 files changed, 405 insertions(+), 2 deletions(-)
 create mode 100644 gcc/config/riscv/bxx51.md
 create mode 100644 gcc/config/riscv/bxx52.md

diff --git a/gcc/config/riscv/bxx51.md b/gcc/config/riscv/bxx51.md
new file mode 100644
index 00000000000..6cb37a61a74
--- /dev/null
+++ b/gcc/config/riscv/bxx51.md
@@ -0,0 +1,143 @@
+(define_automaton "bxx51")
+
+(define_cpu_unit "bxx51_fe_A" "bxx51")
+(define_cpu_unit "bxx51_fe_B" "bxx51")
+
+;; MuLtiplication Unit
+(define_cpu_unit "bxx51_mlu" "bxx51")
+
+;; DiVision Unit
+(define_cpu_unit "bxx51_dvu" "bxx51")
+
+;; Floating Point Divide Unit
+(define_cpu_unit "bxx51_fpdiv" "bxx51")
+
+;; Floating Point Square Root device
+(define_cpu_unit "bxx51_fpsqrt" "bxx51")
+
+;; Floating Point Unit
+(define_cpu_unit "bxx51_fpu" "bxx51")
+
+;; Control Transfer Unit
+(define_cpu_unit "bxx51_ctu" "bxx51")
+
+;; Load Store Unit
+(define_cpu_unit "bxx51_lsu" "bxx51")
+
+(define_reservation "bxx51_fetch" "bxx51_fe_A|bxx51_fe_B")
+
+;; RV64I
+(define_insn_reservation "bxx51_alu" 1
+  (and (eq_attr "tune" "bxx51")
+       (eq_attr "type" "unknown,arith,shift,slt,auipc,const,multi,nop,logical,\
+                        move,min,max,minu,maxu,rotate,condmove,crypto,mvpair,zicond"))
+  "bxx51_fetch")
+
+(define_insn_reservation "bxx51_i_load" 3
+  (and (eq_attr "tune" "bxx51")
+       (eq_attr "type" "load"))
+  "bxx51_fetch+bxx51_lsu")
+
+(define_insn_reservation "bxx51_i_store" 1
+  (and (eq_attr "tune" "bxx51")
+       (eq_attr "type" "store"))
+  "bxx51_fetch+bxx51_lsu")
+
+(define_insn_reservation "bxx51_branch" 1
+  (and (eq_attr "tune" "bxx51")
+       (eq_attr "type" "branch,jump,call,jalr,ret,trap"))
+  "bxx51_fetch+bxx51_ctu")
+
+;; RV64M
+(define_insn_reservation "bxx51_imul" 2
+  (and (eq_attr "tune" "bxx51")
+       (eq_attr "type" "imul"))
+  "bxx51_fetch+bxx51_mlu")
+
+;; We limit unit reservations to 11 cycles to keep automata size small enough for fast rebuild
+(define_insn_reservation "bxx51_si_div" 16
+  (and (eq_attr "tune" "bxx51")
+       (and (eq_attr "type" "idiv") (eq_attr "mode" "SI")))
+  "bxx51_fetch+bxx51_dvu,bxx51_dvu*10")
+
+(define_insn_reservation "bxx51_di_div" 32
+  (and (eq_attr "tune" "bxx51")
+       (and (eq_attr "type" "idiv") (eq_attr "mode" "DI")))
+  "bxx51_fetch+bxx51_dvu,bxx51_dvu*10")
+
+;; RV64F / RV64D
+(define_insn_reservation "bxx51_f_load" 3
