From 4f289935bbe77af05b9649bdcad87239e7f80fd0 Mon Sep 17 00:00:00 2001
From: Andrei Khorokhorin <andrei.khorokhorin@cloudbear.ru>
Date: Wed, 26 Feb 2025 03:06:53 +0300
Subject: Optimize critical path for zicond CRC variant

Issue: CB-4832
Change-Id: I677031fec9fcd2ae4825178decba8f8bfaf0fa50
---
 gcc/config/riscv/cloudbear.md   | 72 +++++++++++++++++++++++++++++++++
 gcc/config/riscv/riscv-protos.h |  1 +
 gcc/config/riscv/riscv.cc       | 42 +++++++++++++++++++
 gcc/config/riscv/riscv.md       |  5 +++
 4 files changed, 120 insertions(+)
 create mode 100644 gcc/config/riscv/cloudbear.md

diff --git a/gcc/config/riscv/cloudbear.md b/gcc/config/riscv/cloudbear.md
new file mode 100644
index 00000000000..08dc935d17e
--- /dev/null
+++ b/gcc/config/riscv/cloudbear.md
@@ -0,0 +1,72 @@
+;; TODO: verify patterns
+;; TODO: replace or with any_bitwize, mb generalize shift instruction?
+
+;; First CRC variant
+;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
+(define_peephole2
+  [
+   (match_scratch:DI 5 "r")
+   (set (match_operand:DI 0 "register_operand")
+	(if_then_else:DI (eq:DI (match_operand:DI 1 "register_operand") (const_int 0))
+			 (const_int 0)
+			 (match_operand:DI 2 "register_operand")))
+   (set (match_dup 0)
+	(xor:DI (match_dup 0) (match_operand:DI 3 "register_operand")))
+   (match_dup 5)
+   (set (match_dup 0) (zero_extend:DI (match_operand:HI 4 "register_operand")))]
+  "TARGET_64BIT
+   && TARGET_ZICOND_LIKE
+   && TARGET_ZBB
+   && REGNO (operands[0]) == REGNO (operands[4])
+   && check_reg_holds_hi_value (peep2_next_insn(0), operands[3])"
+  [
+   (set (match_dup 5) (zero_extend:DI (subreg:HI (match_dup 2) 0)))
+   (set (match_dup 0) (if_then_else:DI (eq:DI (match_dup 1) (const_int 0))
+				       (match_dup 5)
+				       (const_int 0)))
+   (set (match_dup 0) (unspec [(xor:DI (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
+
+;; Second CRC variant
+;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
+(define_peephole2
+  [
+   (match_scratch:DI 5 "r")
+   (set (match_operand:DI 0 "register_operand")
+	(if_then_else:DI (eq:DI (match_operand:DI 1 "register_operand") (const_int 0))
+			 (const_int 0)
+			 (match_operand:DI 2 "register_operand")))
+   (set (match_operand:DI 6 "register_operand")
+        (zero_extend:DI (lshiftrt:SI (match_operand:SI 7 "register_operand")
+				     (match_operand 8 "const_int_operand"))))
+   (set (match_dup 0)
+	(xor:DI (match_dup 0) (match_operand:DI 3 "register_operand")))
+   (match_dup 5)
+   (set (match_dup 0) (zero_extend:DI (match_operand:HI 4 "register_operand")))]
+  "TARGET_64BIT
+   && TARGET_ZICOND_LIKE
+   && TARGET_ZBB
+   && REGNO (operands[3]) == REGNO (operands[6])
+   && REGNO (operands[6]) == REGNO (operands[7])
+   && REGNO (operands[0]) == REGNO (operands[4])
+   && REGNO (operands[0]) != REGNO (operands[6])
+   && REGNO (operands[2]) != REGNO (operands[6])
+   && check_reg_holds_hi_value (peep2_next_insn(0), operands[7])"
+  [(set (match_dup 5) (zero_extend:DI (subreg:HI (match_dup 2) 0)))
+   (set (match_dup 6)
+        (zero_extend:DI (lshiftrt:SI (match_dup 7)
+				     (match_dup 8))))
+   (set (match_dup 0) (if_then_else:DI (eq:DI (match_dup 1) (const_int 0))
+				       (match_dup 5)
+				       (const_int 0)))
+   (set (match_dup 0) (unspec [(xor:DI (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
+
+;; UNSPEC_XBEAR_CRC_PEEPHOLE eliminator
+(define_insn "*cb_<optab><mode>3"
+  [(set (match_operand:X 0 "register_operand" "=r,r")
+	  (unspec [(any_or:X (match_operand:X 1 "register_operand" "%r,r")
+			     (match_operand:X 2 "arith_operand"    " r,I"))]
+		  UNSPEC_XBEAR_CRC_PEEPHOLE))]
+  ""
+  "<insn>%i2\t%0,%1,%2"
+  [(set_attr "type" "logical")
+   (set_attr "mode" "<MODE>")])
diff --git a/gcc/config/riscv/riscv-protos.h b/gcc/config/riscv/riscv-protos.h
index f288ccf8a4d..56aec27717a 100644
--- a/gcc/config/riscv/riscv-protos.h
+++ b/gcc/config/riscv/riscv-protos.h
@@ -757,6 +757,7 @@ extern bool th_classify_address (struct riscv_address_info *,
 					rtx, machine_mode, bool);
 extern const char *th_output_move (rtx, rtx);
 extern bool th_print_operand_address (FILE *, machine_mode, rtx);
