Change-Id: Iee14b1fa71d365b38dd34f1a93794b66e4067947
---
 gdb/riscv-tdep.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/gdb/riscv-tdep.c b/gdb/riscv-tdep.c
index 3a2891c2c92..4c036d94621 100644
--- a/gdb/riscv-tdep.c
+++ b/gdb/riscv-tdep.c
@@ -2215,6 +2215,21 @@ riscv_scan_prologue (struct gdbarch *gdbarch,
   CORE_ADDR original_end_pc = end_pc;
   CORE_ADDR end_prologue_addr = 0;
 
+  /* When the thread stays in Bear reset_rom's 0x10xx addresses,
+     gdb fails to find the correct frame bound without those symbols,
+     so it falls back to 0x0 address (get_pc_function_start).
+     Here we try to scan the prologue starting from 0x0 start_pc,
+     but we have no such memory.
+     To avoid errors on reading 0x0 memory, skip scanning.  */
+  if (start_pc == 0) {
+    if (riscv_debug_unwinder)
+      gdb_printf
+	(gdb_stdlog,
+	 "Skipping prologue scan for function starting at %s \n",
+	 core_addr_to_string (start_pc));
+    return end_prologue_addr;
+  }
+
   /* Find an upper limit on the function prologue using the debug
      information.  If the debug information could not be used to provide
      that bound, then use an arbitrary large number as the upper bound.  */
