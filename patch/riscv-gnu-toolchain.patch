index 75d81c0..449ebc4 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -51,11 +51,11 @@ endif
 get-word = $(word $2,$(subst _, ,$1))
 
 # Template should be called like "checkout-submodule-<name>_<version>", e.g. "checkout-submodule-riscv-gcc_10.2"
-# Checkout version branch if now it at master, otherwise keep current branch.
-# 	grep: -w = exact match.
+# Checkout version branch if now it at master (even in detached state), otherwise keep current branch.
