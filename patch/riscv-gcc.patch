-   (set (match_dup 0) (if_then_else:DI (eq:DI (match_dup 1) (const_int 0))
+   (set (match_dup 5) (zero_extend:X (subreg:HI (match_dup 2) 0)))
+   (set (match_dup 0) (if_then_else:X (eq:X (match_dup 1) (const_int 0))
 				       (match_dup 5)
 				       (const_int 0)))
-   (set (match_dup 0) (unspec [(xor:DI (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
+   (set (match_dup 0) (unspec [(xor:X (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
 
-;; Second CRC variant
+;; Second CRC variant (used for current draft of bxx72 mtune, so 64-bit variant only)
 ;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
 (define_peephole2
   [
