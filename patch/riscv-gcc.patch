--- a/gcc/config/riscv/bitmanip.md
+++ b/gcc/config/riscv/bitmanip.md
@@ -898,7 +898,9 @@
                   (match_operand:GPR 2 "register_operand" "r")]
                   UNSPEC_CLMUL))]
   "TARGET_ZBKC || TARGET_ZBC"
-  "clmul\t%0,%1,%2"
+{
+  return ADD_NOP_FOR_CB_0001_ERRATUM("clmul\t%0,%1,%2");
+}
   [(set_attr "type" "clmul")])
 
 (define_insn "riscv_clmulh_<mode>"
@@ -907,7 +909,9 @@
                   (match_operand:X 2 "register_operand" "r")]
                   UNSPEC_CLMULH))]
   "TARGET_ZBKC || TARGET_ZBC"
-  "clmulh\t%0,%1,%2"
+{
+  return ADD_NOP_FOR_CB_0001_ERRATUM("clmulh\t%0,%1,%2");
+}
   [(set_attr "type" "clmul")])
 
 ;; ZBC extension
@@ -917,7 +921,9 @@
                   (match_operand:X 2 "register_operand" "r")]
                   UNSPEC_CLMULR))]
   "TARGET_ZBC"
-  "clmulr\t%0,%1,%2"
+{
+  return ADD_NOP_FOR_CB_0001_ERRATUM("clmulr\t%0,%1,%2");
+}
   [(set_attr "type" "clmul")])
 
 ;; ZBP 0.9.3 extension.
