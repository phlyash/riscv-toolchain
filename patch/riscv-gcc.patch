diff --git a/gcc/config/riscv/cloudbear.md b/gcc/config/riscv/cloudbear.md
index d76edffb705..036c6cf46fb 100644
--- a/gcc/config/riscv/cloudbear.md
+++ b/gcc/config/riscv/cloudbear.md
@@ -1,4 +1,5 @@
 ;; TODO: replace or with any_bitwize, mb generalize shift instruction?
+
 ;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
 
 ;; Main CRC pattern for zicond
@@ -25,8 +26,32 @@
 				      (match_dup 5)))
    (set (match_dup 0) (unspec [(xor:X (match_dup 0) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
 
+;; Main CRC pattern for SFB
+(define_peephole2
+  [
+   (match_scratch:X 5 "r")
+   (set (match_operand:X 0 "register_operand")
+	(if_then_else:X	  (ne
+			    (match_operand:X 1 "register_operand")
+			    (const_int 0))
+			  (match_dup 0)
+			  (const_int 0)))
+   (set (match_dup 0)
+	(xor:X (match_dup 0) (match_operand:X 3 "register_operand")))
+   (match_dup 5)
+   (set (match_dup 0) (zero_extend:X (match_operand:HI 4 "register_operand")))]
+  "TARGET_SFB_ALU && TARGET_ZBB
+   && REGNO (operands[0]) == REGNO (operands[4])
+   && check_reg_holds_hi_value (peep2_next_insn(0), operands[3])"
+  [
+   (set (match_dup 5) (zero_extend:X (subreg:HI (match_dup 2) 0)))
+   (set (match_dup 5) (if_then_else:X (ne (match_dup 1) (const_int 0))
+				      (match_dup 5)
+				      (const_int 0)))
+   (set (match_dup 0) (unspec [(xor:X (match_dup 5) (match_dup 3))] UNSPEC_XBEAR_CRC_PEEPHOLE))])
+
+
 ;; Second CRC variant (used for current draft of bxx72 mtune, so 64-bit variant only)
-;; Introduce UNSPEC_XBEAR_CRC_PEEPHOLE to recognize that xor output in HImode
 (define_peephole2
   [
    (match_scratch:DI 5 "r")
diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 44301c763f2..df533fa54a9 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -8584,7 +8584,7 @@ check_reg_holds_hi_value_1 (rtx_insn *cur, rtx reg, int rec_limit)
 bool
 check_reg_holds_hi_value (rtx_insn *cur, rtx reg)
 {
-  return check_reg_holds_hi_value_1 (cur, reg, 1);
+  return check_reg_holds_hi_value_1 (cur, reg, 2);
 }
 
 
