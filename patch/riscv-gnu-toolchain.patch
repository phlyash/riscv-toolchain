Date: Fri, 5 Jul 2024 12:09:38 +0300
Subject: fixup! Update submodules and bump versions

Windows toolchain now requires gmp and mpfr

Change-Id: I371ae58646814ac63a866f3a5b3c5272afd0bf27
---
 Makefile.bear | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Makefile.bear b/Makefile.bear
index 8c66b57..8ce5375 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -94,11 +94,11 @@ checkout-8.2:  checkout-submodule-riscv-binutils_2.31.1 \
 # Don't forget to update this target after switching to new version of toolchain!
 checkout-latest: checkout-12.1
 
-# git clean for gcc required for removing dirs with sources (e.g. mpfr lib), which were downloaded from filer during build
+# git clean for gcc and gdb required for removing dirs with sources (e.g. mpfr lib), which were downloaded from filer during build
 # git reset for newlib required because libgloss/riscv/configure is overwritten.
 checkout-master:
 	cd riscv-binutils && git checkout master
-	cd riscv-gdb && git checkout master
+	cd riscv-gdb && git clean -fdx && git checkout master -f
 	cd riscv-gcc && git clean -fdx && git checkout master -f
 	cd riscv-newlib && git reset --hard && git checkout master
 	cd riscv-glibc && git checkout master
@@ -119,9 +119,12 @@ endif
 #	of riscv-windows-compiler.
 # 2. download_prerequisites script does not download libs again, if they exist, but
 #	it unpacks libs and sets appropriate symbol links.
+# 3. After editing this recipe you should ensure that checkout-master target clean up all prerequisites
 copy-riscv-gnu-toolchain-prerequisites:
 	cp -r /mnt/filer/bear/soft/riscv-gcc-prerequisites/*.tar.* riscv-gcc
+	cp -r /mnt/filer/bear/soft/riscv-gcc-prerequisites/*.tar.* riscv-gdb
 	cd riscv-gcc && contrib/download_prerequisites
+	cd riscv-gcc && contrib/download_prerequisites --directory ../riscv-gdb
 
 #
 # Newlib
-- 
