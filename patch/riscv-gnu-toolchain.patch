From 54465dfe5f9254ede8e3ed372f53b61b502e25d4 Mon Sep 17 00:00:00 2001
From: Evgeny Linsky <evgeny.linsky@cloudbear.ru>
Date: Thu, 28 Jul 2022 17:45:26 +0300
Subject: Switch build of toolchain for windows to dynamic libs

Issue: CB-2220
Change-Id: Ic27f35085e1a5b9e981eff388e6ef77ba6cf4b7b
---
 Makefile.bear | 11 +++++++----
 elf-win.flist |  5 +++++
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/Makefile.bear b/Makefile.bear
index 4f9fc35..8af63f5 100644
--- a/Makefile.bear
+++ b/Makefile.bear
@@ -37,13 +37,11 @@ else
 # Build for Windows:
 # --with-host=x86_64-w64-mingw32
 #	Compiler will be executed on Windows
-# LDFLAGS=-static
-#	Avoid problems with *.so on Windows
 # LDFLAGS="/usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll"
 #	Building gdb and binutils for windows on Fedora 35 produces errors: undefined reference to `__strcpy_chk'
 #	Fix from: https://www.mail-archive.com/mingw@lists.fedoraproject.org/msg07672.html
 HOST = --host=x86_64-w64-mingw32
-HOST_LDFLAGS = "-static /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll"
+HOST_LDFLAGS = /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll
 endif
 
 # Simple function for getting i-th word from '_'-separated string.
@@ -400,10 +398,15 @@ endif
 clean-riscv-gnu-toolchain-elf: \
 	clean-riscv-binutils clean-riscv-gdb clean-riscv-gcc-elf clean-riscv-newlib
 
-# libssp-0.dll is required by executables for windows (see HOST_LDFLAGS)
+# dll's are required by executables for windows
 build-riscv-gnu-toolchain-elf-win:
 	+make -f Makefile.bear build-riscv-gnu-toolchain-elf BUILD_FOR=windows
 	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libssp-0.dll $(RISCV)/bin
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libwinpthread-1.dll $(RISCV)/bin
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libexpat-1.dll $(RISCV)/bin
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libgcc_s_seh-1.dll $(RISCV)/bin
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libgmp-10.dll $(RISCV)/bin
+	cp /usr/x86_64-w64-mingw32/sys-root/mingw/bin/libstdc++-6.dll $(RISCV)/bin
 
 clean-riscv-gnu-toolchain-elf-win:
 	+make -f Makefile.bear clean-riscv-gnu-toolchain-elf BUILD_FOR=windows
diff --git a/elf-win.flist b/elf-win.flist
index 4b7976f..2bb3ca1 100644
--- a/elf-win.flist
+++ b/elf-win.flist
@@ -84,6 +84,11 @@ debug bare-metal programs on RISC-V platforms:\n\
         "bin/riscv64-unknown-elf-c++.exe",
         "bin/riscv64-unknown-elf-gcc-12.1.0.exe",
         "bin/libssp-0.dll",
+        "bin/libwinpthread-1.dll",
+        "bin/libexpat-1.dll",
+        "bin/libgcc_s_seh-1.dll",
+        "bin/libgmp-10.dll",
+        "bin/libstdc++-6.dll",
         "lib/gcc/riscv64-unknown-elf/12.1.0",
         "libexec/gcc/riscv64-unknown-elf/12.1.0",
         "riscv64-unknown-elf",
