-{ return (k->ptr[i] >> offset) & ~(~0ULL << size); }			\
-									\
-static __inline__ void SET_##name(struct bkey *k, unsigned int i, __u64 v)	\
-{									\
-	k->ptr[i] &= ~(~(~0ULL << size) << offset);			\
-	k->ptr[i] |= (v & ~(~0ULL << size)) << offset;			\
